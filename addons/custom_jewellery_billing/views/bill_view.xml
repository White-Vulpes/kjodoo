<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custom_bill_line_form" model="ir.ui.view">
        <field name="name">custom.bill.line.form</field>
        <field name="model">custom.bill.line</field>
        <field name="arch" type="xml">
            <form string="Bill Line">
                <sheet>
                    <group>
                        <group string="Item Details">
                            <field name="name"/>
                        </group>
                        <group string="Quantity">
                            <field name="weight" options="{'digits': [16, 3]}"/>
                            <field name="less" options="{'digits': [16, 3]}"/>
                            <field name="net_weight" options="{'digits': [16, 3]}"/>
                        </group>
                    </group>
                    
                    <group string="Calculations">
                        <group>
                            <field name="melting"/>
                            <field name="touch"/>
                            <field name="charges" options="{'digits': [16, 2]}"/>
                        </group>
                        <group>
                            <field name="pure" options="{'digits': [16, 3]}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_custom_bill_line_list" model="ir.ui.view">
        <field name="name">custom.bill.line.list</field>
        <field name="model">custom.bill.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="weight" options="{'digits': [16, 3]}"/>
                <field name="less" options="{'digits': [16, 3]}"/>
                <field name="net_weight" options="{'digits': [16, 3]}"/>
                <field name="melting"/>
                <field name="touch"/>
                <field name="pure" options="{'digits': [16, 3]}"/>
                <field name="charges" options="{'digits': [16, 2]}"/>
            </list>
        </field>
    </record>

    <record id="view_custom_bill_form" model="ir.ui.view">
        <field name="name">custom.bill.form</field>
        <field name="model">custom.bill</field>
        <field name="arch" type="xml">
            <form string="Jewelry Bill">
                 <header>
                    <button name="action_print_bill"
                            type="object"
                            string="Print Bill"
                            class="btn-primary"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1><field name="partner_id" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="bill_number"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Bill Items">
                            <field name="item_ids" context="{'list_view_ref': 'custom_jewellery_billing.view_custom_bill_line_list'}"/>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_weight" options="{'digits': [16, 3]}"/>
                                <field name="total_pure" options="{'digits': [16, 3]}"/>
                                <field name="total_charges" options="{'digits': [16, 2]}"/>
                            </group>
                        </page>
                    </notebook>
                    <notebook>
                        <page string="Ledger / Transactions">
                            <field name="transaction_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="ttype"/>
                                    <field name="gross_weight" invisible="ttype not in ('metal_recv', 'metal_pay')"/>
                                    <field name="purity" invisible="ttype not in ('metal_recv', 'metal_pay')"/>
                                    <field name="pure_weight" invisible="ttype not in ('metal_recv', 'metal_pay', 'rate_cut')"/>
                                    <field name="rate" invisible="ttype != 'rate_cut'" required="ttype == 'rate_cut'"/>
                                    <field name="amount" invisible="ttype not in ('cash_recv', 'cash_pay', 'rate_cut')"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer oe_right" style="border-top: 2px solid #ccc; margin-top: 10px; padding-top: 10px;">
                        <field name="balance_pure" class="fw-bold" style="font-size: 1.2em;"/>
                        <field name="balance_charges" class="fw-bold" style="font-size: 1.2em;"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_custom_bill_list" model="ir.ui.view">
        <field name="name">custom.bill.list</field>
        <field name="model">custom.bill</field>
        <field name="arch" type="xml">
            <list string="Jewelry Bills">
                <field name="bill_number"/>
                <field name="partner_id" string="Customer"/>
                <field name="date"/>
                <field name="total_weight" options="{'digits': [16, 3]}"/>
                <field name="total_pure" options="{'digits': [16, 3]}"/>
                <field name="total_charges" options="{'digits': [16, 2]}"/>
            </list>
        </field>
    </record>

    <record id="action_custom_bill" model="ir.actions.act_window">
        <field name="name">Jewelry Bills</field> 
        <field name="res_model">custom.bill</field>
        <field name="view_mode">list,form</field> 
    </record>

    <menuitem id="menu_custom_bill_root" name="Jewelry Billing" web_icon="custom_bill,static/description/icon.png"/>
    
    <menuitem id="menu_custom_bills" name="Bills" parent="menu_custom_bill_root" action="action_custom_bill" sequence="10"/>

</odoo>