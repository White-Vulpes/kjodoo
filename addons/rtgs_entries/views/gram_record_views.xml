<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gram_tag_form" model="ir.ui.view">
        <field name="name">gram.tag.form</field>
        <field name="model">gram.tag</field>
        <field name="arch" type="xml">
            <form string="RTGS Status Tag">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gram_record_form" model="ir.ui.view">
        <field name="name">gram.record.form</field>
        <field name="model">gram.record</field>
        <field name="arch" type="xml">
            <form string="RTGS Entry">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="partner_id" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" context="{'custom_kanban_title': False}"/>
                            <field name="grams"/>
                            <field name="rate"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="pure"/>
                        </group>
                    </group>
                    <field name='gst'/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_gram_record_kanban" model="ir.ui.view">
        <field name="name">gram.record.kanban</field>
        <field name="model">gram.record</field>
        <field name="arch" type="xml">
            <kanban default_group_by="missing_tag_ids" class="o_kanban_small_column custom_pending_kanban" records_draggable="false">
                <field name="partner_id"/>
                <field name="tag_ids"/>
                <field name="grams"/>
                <field name="amount"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"> 
                                    <field name="partner_id"/>
                                </strong>
                                
                                <div class="mt-1 mb-1">
                                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" context="{'custom_kanban_title': False}"/>
                                </div>
                                
                                <div class="mt-2 text-muted">
                                    <span>Grams: <field name="grams"/></span><br/>
                                    <span>Amount: <field name="amount"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_gram_record" model="ir.actions.act_window">
        <field name="name">Transactions</field>
        <field name="res_model">gram.record</field>
        <field name="view_mode">kanban,form</field>

        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new RTGS Entry!
            </p>
        </field>
    </record>

    <record id="action_gram_tags" model="ir.actions.act_window">
        <field name="name">Transaction Tags</field>
        <field name="res_model">gram.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_gram_root" name="RTGS Entry Management" sequence="10"/>
    <menuitem id="menu_gram_records" name="Entries" parent="menu_gram_root" action="action_gram_record" sequence="10"/>
    
    <menuitem id="menu_gram_config" name="Configuration" parent="menu_gram_root" sequence="100"/>
    <menuitem id="menu_gram_tag_config" name="Tags" parent="menu_gram_config" action="action_gram_tags"/>

</odoo>