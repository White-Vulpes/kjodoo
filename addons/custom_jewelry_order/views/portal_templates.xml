<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_home_jewelry" name="Show Jewelry Orders" inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Jewelry Orders</t>
                <t t-set="url" t-value="'/my/jewelry_orders'"/>
                <t t-set="placeholder_count" t-value="'jewelry_count'"/>
            </t>
        </xpath>
    </template>

    <template id="portal_my_jewelry_orders" name="My Jewelry Orders">
        <t t-call="portal.portal_layout">
            <h3>Your Custom Jewelry Orders</h3>
            <t t-if="not orders">
                <p>You currently have no jewelry orders.</p>
            </t>
            <t t-if="orders" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Order Reference</th>
                        <th>Date</th>
                        <th>Item Type</th>
                        <th class="text-end">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="orders" t-as="order">
                        <tr>
                            <td><a t-att-href="order.access_url"><t t-esc="order.name"/></a></td>
                            <td><span t-field="order.date_order"/></td>
                            <td><span t-field="order.item_type.name"/></td>
                            <td class="text-end">
                                <span class="badge rounded-pill text-bg-info" t-field="order.state"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>

    <template id="portal_jewelry_order_detail" name="Jewelry Order Details">
        <t t-call="portal.portal_layout">
            
            <!-- MOVED HERE: EXCLUSIVE DESIGNS SLIDESHOW -->
            <t t-if="showcase_designs">
                <div id="jewelryShowcaseCarousel" class="carousel slide mb-4" data-bs-ride="carousel" data-bs-interval="8000">
                    <div class="carousel-inner rounded shadow-sm">
                        <t t-foreach="showcase_designs" t-as="design">
                            <div t-attf-class="carousel-item #{'active' if design_index == 0 else ''}">
                                <img t-att-src="image_data_uri(design.image)" class="d-block w-100" style="object-fit: cover; max-height: 400px; border-radius: 8px;"/>
                            </div>
                        </t>
                    </div>
                    <!-- Navigation Arrows -->
                    <t t-if="len(showcase_designs) > 1">
                        <button class="carousel-control-prev" type="button" data-bs-target="#jewelryShowcaseCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#jewelryShowcaseCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </t>
                </div>
            </t>
            
            <div class="row mt16">
                <div class="col-12 col-lg-8">
                    <div class="card mb-4">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h4 class="mb-0">Order: <span t-field="order.name"/></h4>
                            <span class="badge text-bg-primary fs-6" t-field="order.state"/>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-6 mb-3">
                                    <strong>Item Type:</strong><br/>
                                    <span t-field="order.item_type.name"/>
                                </div>
                                <div class="col-6 mb-3">
                                    <strong>Melting:</strong><br/>
                                    <span t-field="order.melting_id.name"/>
                                </div>
                                <div class="col-6 mb-3">
                                    <strong>Weight:</strong><br/>
                                    <span t-field="order.weight"/> x  <span t-field="order.pieces"/> = <span t-field="order.total_wt"/> g
                                </div>
                                <div class="col-6 mb-3">
                                    <strong>Size:</strong><br/>
                                    <span t-field="order.size_id.name"/>
                                </div>
                                <t t-if="order.broadness_id">
                                    <div class="col-6 mb-3">
                                        <strong>Broadness:</strong><br/>
                                        <span t-field="order.broadness_id.name"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- THE CHATTER SYSTEM -->
                    <div id="jewelry_order_communication" class="mt-4">
                        <h4>Updates</h4>
                        <t t-call="portal.message_thread">
                            <t t-set="object" t-value="order"/>
                            <t t-set="token" t-value="token"/>
                            <t t-set="pid" t-value="pid"/>
                            <t t-set="hash" t-value="hash"/>
                            <t t-set="disable_composer" t-value="True"/>
                        </t>
                    </div>
                </div>

                <div class="col-12 col-lg-4">
                    <div class="card">
                        <div class="card-header"><h5 class="mb-0">Design References</h5></div>
                        <div class="card-body text-center">
                            <t t-if="order.reference_image_ids">
                                <t t-foreach="order.reference_image_ids" t-as="img">
                                    <div class="mb-3 border rounded p-1 text-center">
                                        
                                        <!-- SCENARIO 1: It is a Video -->
                                        <t t-if="img.mimetype and 'video' in img.mimetype">
                                            <video controls="1" style="max-width: 100%; max-height: 250px; border-radius: 4px;">
                                                <source t-attf-src="/web/content/#{img.id}?access_token=#{img.access_token}" t-att-type="img.mimetype"/>
                                                Your browser does not support the video tag.
                                            </video>
                                        </t>
                                        
                                        <!-- SCENARIO 2: It is a Standard Image -->
                                        <t t-else="">
                                            <img t-if="img.datas" t-att-src="image_data_uri(img.datas)" style="max-width: 100%; max-height: 250px; border-radius: 4px;"/>
                                        </t>
                                        
                                    </div>
                                </t>
                            </t>
                            <t t-else="">
                                <p class="text-muted mb-0">No reference images attached.</p>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>