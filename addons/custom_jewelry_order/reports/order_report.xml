<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. The Print Action (Adds the 'Print' button to the UI) -->
    <record id="action_report_custom_jewelry_order" model="ir.actions.report">
        <field name="name">Jewelry Order Details</field>
        <field name="model">custom.jewelry.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_jewelry_order.report_jewelry_order_document</field>
        <field name="report_file">custom_jewelry_order.report_jewelry_order_document</field>
        <field name="binding_model_id" ref="model_custom_jewelry_order"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Order - %s' % (object.name)</field>
    </record>

    <!-- 2. The PDF Template -->
    <template id="report_jewelry_order_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="doc">
                    <div class="page">
                        
                        <!-- Header -->
                        <div class="row mb-4">
                            <div class="col-12 text-center">
                                <h2 style="border-bottom: 2px solid #000; padding-bottom: 10px;">
                                    Custom Jewelry Order: <span t-field="doc.name"/>
                                </h2>
                            </div>
                        </div>

                        <!-- Customer & Dates -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <strong>Customer Details:</strong><br/>
                                <span t-field="doc.partner_id.name"/><br/>
                                <span t-field="doc.partner_id.phone"/><br/>
                                <span t-field="doc.partner_id.email"/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Order Date:</strong> <span t-field="doc.date_order"/><br/>
                                <strong>Expected Delivery:</strong> <span t-field="doc.expected_date"/><br/>
                                <strong>Current Status:</strong> <span t-field="doc.state"/>
                            </div>
                        </div>

                        <!-- Order Specifications -->
                        <h4 class="mt-4 border-bottom pb-2">Order Specifications</h4>
                        <table class="table table-sm table-bordered mt-3">
                            <tr>
                                <th style="width: 25%; background-color: #f8f9fa;">Item Type</th>
                                <td style="width: 25%;"><span t-field="doc.item_type"/></td>
                                <th style="width: 25%; background-color: #f8f9fa;">Gold Purity</th>
                                <td style="width: 25%;"><span t-field="doc.karat_purity"/></td>
                            </tr>
                            <tr>
                                <th style="background-color: #f8f9fa;">Est. Weight</th>
                                <td><span t-field="doc.estimated_weight"/> g</td>
                                <th style="background-color: #f8f9fa;">Advance Deposit</th>
                                <td><span t-field="doc.advance_payment" t-options='{"widget": "monetary", "display_currency": res_company.currency_id}'/></td>
                            </tr>
                        </table>

                        <!-- Design Notes -->
                        <t t-if="doc.description">
                            <h4 class="mt-4 border-bottom pb-2">Design Notes &amp; Description</h4>
                            <p class="mt-2" style="white-space: pre-wrap;"><span t-field="doc.description"/></p>
                        </t>

                        <!-- Reference Images Gallery -->
                        <t t-if="doc.reference_image_ids">
                            <h4 class="mt-4 border-bottom pb-2">Reference Gallery</h4>
                            <div class="row mt-3">
                                <t t-foreach="doc.reference_image_ids" t-as="img">
                                    <div class="col-4 text-center mb-4">
                                        <div style="border: 1px solid #ddd; padding: 5px; border-radius: 5px;">
                                            <span t-field="img.image" t-options="{'widget': 'image', 'style': 'max-width: 100%; max-height: 200px; object-fit: contain;'}"/>
                                            <div class="mt-2 text-muted" style="font-size: 0.9em;">
                                                <strong><span t-field="img.name"/></strong>
                                                <t t-if="img.notes">
                                                    <br/><i><span t-field="img.notes"/></i>
                                                </t>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </t>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>