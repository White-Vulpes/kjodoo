<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="jewelry_public_catalog" name="Jewelry Catalog">
        <t t-call="website.layout">
            <div id="wrap" class="container mt-4 mb-5">
                <h2 class="text-center mb-5" style="color: #333;">Our Exclusive Collection</h2>

                <style>
                    .select2-container--default .select2-selection--multiple .select2-selection__choice {
                        background-color: #F0CDA8 !important;
                        color: #000000 !important;
                        border-radius: 15px !important; 
                        font-size: 0.75em !important;
                        font-weight: 200 !important;
                        margin: 2px 2px 2px 0px !important;
                        text-align: center !important;
                        padding-left: 13px !important;
                    }
                    
                    /* The 'x' button on the tag */
                    .select2-container--default .select2-selection--multiple .select2-selection__choice__remove {
                        color: #000000 !important;
                        border-right: 0px !important;
                    }

                    /* Make the 'x' turn red when hovered */
                    .select2-container--default .select2-selection--multiple .select2-selection__choice__remove:hover {
                        color: #ff4d4d !important;
                        background-color: transparent !important;
                    }
                </style>

                <form action="/catalog" method="get" class="mb-5 p-4 rounded">
                    <div class="row justify-content-center mb-3">
                        <div class="col-md-9 mb-2">
                            <input type="text" name="search" class="form-control" placeholder="Search by name or ID..." t-att-value="search"/>
                        </div>
                        <div class="col-md-3 mb-2">
                            <button type="submit" class="btn btn-dark w-100">Apply Filters</button>
                        </div>
                    </div>
                    
                    <div class="row justify-content-center">
                        <div class="col-md-3 mb-2">
                            <select name="size_id" class="form-select">
                                <option value="">All Sizes</option>
                                <t t-foreach="sizes" t-as="s">
                                    <option t-att-value="s.id" t-att-selected="s.id == selected_size">
                                        <t t-esc="s.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>

                        <div class="col-md-3 mb-2">
                            <div class="input-group">
                                <span class="input-group-text">Min Wt</span>
                                <input type="number" step="0.01" name="min_weight" class="form-control" placeholder="0.00" t-att-value="min_weight"/>
                            </div>
                        </div>

                        <div class="col-md-3 mb-2">
                            <div class="input-group">
                                <span class="input-group-text">Max Wt</span>
                                <input type="number" step="0.01" name="max_weight" class="form-control" placeholder="100.00" t-att-value="max_weight"/>
                            </div>
                        </div>
                    </div>
                    <div class="row justify-content-center mt-3">
                        <div class="col-md-6 mb-2">
                            <select name="tag_ids" class="form-control o_select2_tags px-4 py-2" multiple="multiple" data-placeholder="Choose Designs...">
                                <t t-foreach="tags" t-as="t">
                                    <option t-att-value="t.id" t-att-selected="t.id in selected_tags">
                                        <t t-esc="t.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                    </div>
                </form>
                <div class="row">
                    <t t-foreach="items" t-as="item">
                        <div class="col-md-4 mb-4">
                            <div class="card h-100 shadow-sm border-0">
                                <span t-field="item.image_1920" t-options="{'widget': 'image', 'preview_image': 'image_1920'}" class="card-img-top"/>
                                
                                <div class="card-body text-center">
                                    <h5 class="card-title mb-1"><span t-field="item.name"/></h5>
                                    <p class="text-muted small mb-3">ID: <span t-field="item.barcode"/></p>
                                    
                                    <div class="d-flex justify-content-between px-2 rounded">
                                        <span t-if="item.size"><strong>Size:</strong> <span t-field="item.size"/></span>
                                        <span><strong>Wt:</strong> <span t-field="item.weight" t-options='{"widget": "float", "precision": 3}'/> g</span>
                                    </div>
                                    <div class="d-flex justify-content-between px-2 rounded">
                                        <span t-if="item.pieces"><strong>Pieces:</strong> <span t-field="item.pieces"/></span>
                                    </div>
                                    
                                    <div class="px-2 mb-2 mt-2">
                                        <t t-foreach="item.design_tag_ids" t-as="tag">
                                            <span class="badge bg-secondary" style="font-size: 0.75em; font-weight: 200;">
                                                <t t-esc="tag.name"/>
                                            </span>
                                        </t>
                                    </div>
                                    
                                    <!-- <p class="mt-2 card-text text-start text-muted" style="font-size: 0.9em;">
                                        <span t-field="item.narration"/>
                                    </p> -->
                                </div>
                                
                                <div class="card-footer bg-white border-0 text-center pb-4">
                                    <a t-attf-href="mailto:info@yourbrand.com?subject=Inquiry for {{ item.barcode }} - {{ item.name }}" class="btn btn-outline-dark rounded-pill px-4">
                                        Inquire Now
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
                <t t-if="not items">
                    <div class="alert alert-info text-center mt-5">
                        Our collection is currently being updated. Please check back soon!
                    </div>
                </t>
                <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
                
                <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
                
                <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
                <script type="text/javascript">
                    $(document).ready(function() {
                        $('.o_select2_tags').select2({
                            width: '100%',
                            allowClear: true
                        });
                    });
                </script>
            </div>
        </t>
    </template>
</odoo>