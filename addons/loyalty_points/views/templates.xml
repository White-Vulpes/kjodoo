    </main>

    <footer>
        <p>2026 Kothari Jewels. All rights reserved.</p>
        <p style="margin-top: 0.5rem;"><a href="#" style="color: #6b7280; text-decoration: none;">Terms &amp; Conditions</a> | <a href="#" style="color: #6b7280; text-decoration: none;">Privacy Policy</a></p>
