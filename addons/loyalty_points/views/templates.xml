            </div>
            <div class="perk-card">
                <div class="perk-icon">✨</div>
                <div class="perk-title">Priority Services</div>
                <div class="perk-desc">Enjoy expedited support and complimentary premium services.</div>
            </div>
        </div>

        <h3 class="section-title">Points History</h3>
        <div class="history-container">
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Activity</th>
                        <th>Order Value</th>
                        <th>Points Earned</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Apr 15, 2026</td>
                        <td>
                            <div class="transaction-type">Product Purchase</div>
                            <div style="font-size: 0.8rem; color: #6b7280;">Order #INV-2026-0042</div>
                        </td>
                        <td>$450.00</td>
                        <td class="points-earned">+450 pts</td>
                    </tr>
                    <tr>
                        <td>Apr 10, 2026</td>
                        <td>
                            <div class="transaction-type type-referral">Successful Referral</div>
                            <div style="font-size: 0.8rem; color: #6b7280;">Referred: John Doe</div>
                        </td>
                        <td>—</td>
                        <td class="points-earned type-referral">+1,000 pts</td>
                    </tr>
                    <tr>
                        <td>Mar 28, 2026</td>
                        <td>
                            <div class="transaction-type">Product Purchase</div>
                            <div style="font-size: 0.8rem; color: #6b7280;">Order #INV-2026-0021</div>
                        </td>
                        <td>$1,200.00</td>
                        <td class="points-earned">+1,200 pts</td>
