    <!-- ANALYTICS ACTION: Item Type Report (C) -->
    <record id="action_jewelry_item_type_report" model="ir.actions.act_window">
        <field name="name">Item Type Report</field>
        <field name="res_model">custom.jewelry.order</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{'search_default_group_item_type': 1}</field>
    </record>
    <record id="action_jewelry_item_type_report_view_graph" model="ir.actions.act_window.view">
