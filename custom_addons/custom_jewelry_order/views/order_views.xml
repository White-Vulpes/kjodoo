        <field name="name">Seal &amp; Melting Mix</field>
        <field name="res_model">custom.jewelry.order</field>
        <field name="view_mode">graph,pivot,list</field>
    </record>
    <record id="action_jewelry_seal_report_view_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_jewelry_order_graph_seal"/>
        <field name="act_window_id" ref="action_jewelry_seal_report"/>
