    <record id="action_jewelry_seal_report_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_jewelry_order_pivot_seal"/>
        <field name="act_window_id" ref="action_jewelry_seal_report"/>
    </record>
    <record id="action_jewelry_seal_report_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_custom_jewelry_order_list"/>
        <field name="act_window_id" ref="action_jewelry_seal_report"/>
    </record>

    <!-- ACTIONS FOR CONFIGURATION MENUS -->
    <record id="action_config_item_type" model="ir.actions.act_window">
        <field name="name">Item Types</field>
        <field name="res_model">custom.jewelry.item.type</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_config_seal" model="ir.actions.act_window">
        <field name="name">Seals</field>
        <field name="res_model">custom.jewelry.seal</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENUS -->
    <record id="action_jewelry_size" model="ir.actions.act_window">
        <field name="name">Sizes</field>
        <field name="res_model">jewelry.size</field>
        <field name="view_mode">list,form</field>
