        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_jewelry_order_pivot_item_type"/>
        <field name="act_window_id" ref="action_jewelry_item_type_report"/>
    </record>
    <record id="action_jewelry_item_type_report_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_custom_jewelry_order_list"/>
