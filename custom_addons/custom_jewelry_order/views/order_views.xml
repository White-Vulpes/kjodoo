    </record>

    <!-- ============================================================ -->
    <!-- F. SEAL & MELTING MIX ANALYTICS                              -->
    <!-- ============================================================ -->
    <record id="view_jewelry_order_graph_seal" model="ir.ui.view">
        <field name="name">custom.jewelry.order.graph.seal</field>
        <field name="model">custom.jewelry.order</field>
        <field name="arch" type="xml">
            <graph string="Seal &amp; Melting Mix" type="bar" stacked="1">
                <field name="seal" type="row"/>
                <field name="melting_id" type="col"/>
            </graph>
        </field>
    </record>
    <record id="view_jewelry_order_pivot_seal" model="ir.ui.view">
        <field name="name">custom.jewelry.order.pivot.seal</field>
        <field name="model">custom.jewelry.order</field>
        <field name="arch" type="xml">
            <pivot string="Seal &amp; Melting Analysis" disable_linking="0">
                <field name="seal" type="row"/>
                <field name="melting_id" type="col"/>
                <field name="total_wt" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- MAIN ACTION -->
    <record id="action_custom_jewelry_order" model="ir.actions.act_window">
        <field name="name">Custom Orders</field>
        <field name="res_model">custom.jewelry.order</field>
        <field name="view_mode">kanban,list,form,graph,pivot</field>
    </record>

    <!-- ANALYTICS ACTION: Manufacturer Report -->
    <record id="action_jewelry_manufacturer_report" model="ir.actions.act_window">
        <field name="name">Manufacturer Report</field>
        <field name="res_model">custom.jewelry.order</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{'search_default_group_manufacturer': 1}</field>
    </record>

    <!-- ANALYTICS ACTION: Customer Report (B) -->
    <record id="action_jewelry_customer_report" model="ir.actions.act_window">
        <field name="name">Customer Report</field>
        <field name="res_model">custom.jewelry.order</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{'search_default_group_partner': 1}</field>
    </record>
    <record id="action_jewelry_customer_report_view_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_jewelry_order_graph_customer"/>
        <field name="act_window_id" ref="action_jewelry_customer_report"/>
    </record>
    <record id="action_jewelry_customer_report_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_jewelry_order_pivot_customer"/>
        <field name="act_window_id" ref="action_jewelry_customer_report"/>
    </record>
    <record id="action_jewelry_customer_report_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_custom_jewelry_order_list"/>
        <field name="act_window_id" ref="action_jewelry_customer_report"/>
