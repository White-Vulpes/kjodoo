        <field name="name">custom.jewelry.order.graph.item.type</field>
        <field name="model">custom.jewelry.order</field>
        <field name="arch" type="xml">
            <graph string="Orders by Item Type" type="bar" stacked="1">
                <field name="item_type" type="row"/>
                <field name="state" type="col"/>
            </graph>
        </field>
    </record>
    <record id="view_jewelry_order_pivot_item_type" model="ir.ui.view">
        <field name="name">custom.jewelry.order.pivot.item.type</field>
        <field name="model">custom.jewelry.order</field>
        <field name="arch" type="xml">
            <pivot string="Item Type Analysis" disable_linking="0">
                <field name="item_type" type="row"/>
                <field name="date_order" interval="month" type="col"/>
                <field name="total_wt" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- D. PIPELINE / STATUS ANALYTICS                               -->
    <!-- ============================================================ -->
    <record id="view_jewelry_order_graph_pipeline" model="ir.ui.view">
        <field name="name">custom.jewelry.order.graph.pipeline</field>
        <field name="model">custom.jewelry.order</field>
        <field name="arch" type="xml">
            <graph string="Order Pipeline" type="pie">
                <field name="state" type="row"/>
            </graph>
        </field>
    </record>
    <record id="view_jewelry_order_pivot_pipeline" model="ir.ui.view">
        <field name="name">custom.jewelry.order.pivot.pipeline</field>
        <field name="model">custom.jewelry.order</field>
        <field name="arch" type="xml">
            <pivot string="Pipeline Analysis" disable_linking="0">
                <field name="state" type="row"/>
                <field name="date_order" interval="month" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- E. MONTHLY TREND ANALYTICS                                   -->
    <!-- ============================================================ -->
    <record id="view_jewelry_order_graph_trend" model="ir.ui.view">
        <field name="name">custom.jewelry.order.graph.trend</field>
        <field name="model">custom.jewelry.order</field>
        <field name="arch" type="xml">
            <graph string="Monthly Trend" type="line">
                <field name="date_order" interval="month" type="row"/>
                <field name="total_wt" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_jewelry_order_pivot_trend" model="ir.ui.view">
        <field name="name">custom.jewelry.order.pivot.trend</field>
        <field name="model">custom.jewelry.order</field>
        <field name="arch" type="xml">
