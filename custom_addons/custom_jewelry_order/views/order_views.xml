<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FORM VIEW -->
    <record id="view_custom_jewelry_order_form" model="ir.ui.view">
        <field name="name">custom.jewelry.order.form</field>
        <field name="model">custom.jewelry.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_print_order"
                            type="object"
                            string="Generate PDF"
                            class="btn-primary"/>
                    <button name="action_send_whatsapp"
                            type="object"
                            string="Send WhatsApp"
                            class="btn-primary"/>
                    <field 
                       name="state" 
                       widget="statusbar" 
                       options="{'clickable': '1'}" 
                       statusbar_visible="cancelled,draft,confirmed,manufacturing,ready,delivered"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_visits" icon="fa-eye">
                            <field name="visit_count" widget="statinfo" string="Portal Views"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <!-- Left Column: Customer & Dates -->
                        <group string="Order Info">
                            <field name="partner_id" widget="res_partner_many2one"/>
                            <field name="manufacturer_id" placeholder="Select Workshop..."/>
                            <field name="date_order"/>
                            <field name="expected_date"/>
                        </group>
                        
                        <!-- Right Column: Specs & Measurements -->
                        <group string="Specifications">
                            <!-- no_quick_create prevents users from typing typos and pressing enter -->
                            <field name="weight"/>
                            <field name="pieces"/>
                            <field name="total_wt" class="oe_subtotal_footer_separator"/>
                            <hr colspan="2"/>
                            <field name="item_type" options="{'no_quick_create': True}"/>
                            <field name="seal" options="{'no_quick_create': True}"/>
                            <field name="size_id" options="{'no_quick_create': True}"/>
                            <field name="melting_id" options="{'no_quick_create': True}"/>
                            <field name="broadness_id" options="{'no_quick_create': True}"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Design &amp; Attachments">
                            <group>
                                <field name="description"/>
                            </group>
                            <separator string="Reference Photos"/>
                            <field name="reference_image_ids" widget="many2many_binary" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- LIST VIEW (Odoo 18 Format) -->
    <record id="view_custom_jewelry_order_list" model="ir.ui.view">
        <field name="name">custom.jewelry.order.list</field>
        <field name="model">custom.jewelry.order</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" decoration-success="state == 'ready'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_order"/>
                <field name="item_type"/>
                <field name="total_wt" sum="Total Gold Weight"/>
                <field name="state" widget="badge" decoration-muted="state == 'draft'"
                           decoration-info="state == 'confirmed'"
                           decoration-warning="state == 'manufacturing'"
                           decoration-success="state in ('ready', 'delivered')"
                           decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>
    <!-- KANBAN VIEW (Odoo 18 Format) -->
    <record id="view_custom_jewelry_order_kanban" model="ir.ui.view">
        <field name="name">custom.jewelry.order.kanban</field>
        <field name="model">custom.jewelry.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" sample="1" decoration-info="state == 'draft'" decoration-success="state == 'ready'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="item_type"/>
                <field name="total_wt"/>
                <field name="state"/>
                <!-- REQUIRED: Load the images into the Kanban memory -->
                <field name="reference_image_ids"/>
                <field name="is_delivery_urgent"/>
                <field name="manufacturer_id"/>
                
                <templates>
                    <t t-name="card">
                        
                        <!-- THE MAGIC: If urgent is true, add Bootstrap's subtle red background and a red border -->
                        <div t-attf-class="oe_kanban_global_click p-0 #{record.is_delivery_urgent.raw_value ? 'bg-danger-subtle border border-danger' : ''}">
                            
                            <!-- THE COVER IMAGE -->
                            <t t-if="record.reference_image_ids.raw_value.length > 0">
                                <img t-attf-src="/web/image/#{record.reference_image_ids.raw_value[0]}" 
                                     class="w-100" 
                                     style="height: 180px; object-fit: cover; border-top-left-radius: 4px; border-top-right-radius: 4px;" 
                                     alt="Design Reference"/>
                            </t>
                            
                            <!-- THE CARD DETAILS -->
                            <div class="p-2">
                                <div class="d-flex justify-content-between mb-1">
                                    <strong class="fs-5">
                                        <!-- Add a little warning icon next to the name if it's urgent -->
                                        <t t-if="record.is_delivery_urgent.raw_value">
                                            <i class="fa fa-exclamation-triangle text-danger me-1" title="Urgent Delivery!"/>
                                        </t>
                                        <field name="name"/>
                                    </strong>
                                    <span class="badge text-bg-secondary fs-6"><field name="total_wt"/> g</span>
                                </div>
                                
                                <div class="mt-2">
                                    <div><i class="fa fa-user me-2"/> <field name="partner_id"/></div>
                                    <t t-if="record.manufacturer_id.raw_value">
                                        <div class="text-primary mt-1">
                                            <i class="fa fa-industry me-2"/> <field name="manufacturer_id"/>
                                        </div>
                                    </t>
                                    <div class="text-muted"><i class="fa fa-diamond me-2"/> <field name="item_type"/></div>
                                    
                                    <!-- Show the delivery date in bold red if urgent -->
                                    <div t-attf-class="mt-1 #{record.is_delivery_urgent.raw_value ? 'text-danger fw-bold' : 'text-muted'}">
                                        <i class="fa fa-calendar me-2"/> <field name="expected_date"/>
                                    </div>
                                </div>
                                
                                <!-- Bottom: Thumbnails & State Indicator -->
                                <div t-attf-class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top #{record.is_delivery_urgent.raw_value ? 'border-danger' : ''}">
                                    
                                    <div class="d-flex align-items-center gap-1">
                                        <t t-foreach="record.reference_image_ids.raw_value.slice(0, 3)" t-as="img_id">
                                            <img t-attf-src="/web/image/#{img_id}" 
                                                 class="rounded border" 
                                                 style="width: 26px; height: 26px; object-fit: cover; box-shadow: 0 1px 2px rgba(0,0,0,0.1);" 
                                                 alt="Thumb"/>
                                        </t>
                                        <t t-if="record.reference_image_ids.raw_value.length > 3">
                                            <span class="text-muted ms-1 fw-bold" style="font-size: 0.75em;">
                                                +<t t-esc="record.reference_image_ids.raw_value.length - 3"/>
                                            </span>
                                        </t>
                                    </div>
                                    
                                    <field name="state" widget="badge" 
                                           decoration-muted="state == 'draft'"
                                           decoration-info="state == 'confirmed'"
                                           decoration-warning="state == 'manufacturing'"
                                           decoration-success="state in ('ready', 'delivered')"
                                           decoration-danger="state == 'cancelled'"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!-- SEARCH VIEW -->
    <record id="view_custom_jewelry_order_search" model="ir.ui.view">
        <field name="name">custom.jewelry.order.search</field>
        <field name="model">custom.jewelry.order</field>
        <field name="arch" type="xml">
            <search string="Search Orders">
                <field name="name" string="Order Ref"/>
                <field name="partner_id" string="Customer"/>
                <field name="manufacturer_id" string="Manufacturer"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="In Manufacturing" name="manufacturing" domain="[('state','=','manufacturing')]"/>
                <filter string="Ready" name="ready" domain="[('state','=','ready')]"/>
                <filter string="Delivered" name="delivered" domain="[('state','=','delivered')]"/>
                <separator/>
                <filter string="Order Date" name="filter_date_order" date="date_order"/>
                <group>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Manufacturer" name="group_manufacturer" context="{'group_by': 'manufacturer_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Order Date" name="group_date" context="{'group_by': 'date_order:month'}"/>
                    <filter string="Item Type" name="group_item_type" context="{'group_by': 'item_type'}"/>
                    <filter string="Seal" name="group_seal" context="{'group_by': 'seal'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- GRAPH VIEW: Orders by Manufacturer -->
    <record id="view_custom_jewelry_order_graph" model="ir.ui.view">
        <field name="name">custom.jewelry.order.graph</field>
        <field name="model">custom.jewelry.order</field>
        <field name="arch" type="xml">
            <graph string="Orders by Manufacturer" type="bar" stacked="1">
                <field name="manufacturer_id" type="row"/>
                <field name="state" type="col"/>
            </graph>
        </field>
    </record>

    <!-- PIVOT VIEW: Manufacturer Performance -->
    <record id="view_custom_jewelry_order_pivot" model="ir.ui.view">
        <field name="name">custom.jewelry.order.pivot</field>
        <field name="model">custom.jewelry.order</field>
        <field name="arch" type="xml">
            <pivot string="Manufacturer Performance" disable_linking="0">
                <field name="manufacturer_id" type="row"/>
                <field name="date_order" interval="month" type="col"/>
                <field name="total_wt" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- B. CUSTOMER ANALYTICS                                        -->
    <!-- ============================================================ -->
    <record id="view_jewelry_order_graph_customer" model="ir.ui.view">
        <field name="name">custom.jewelry.order.graph.customer</field>
        <field name="model">custom.jewelry.order</field>
        <field name="arch" type="xml">
            <graph string="Orders by Customer" type="bar">
                <field name="partner_id" type="row"/>
                <field name="total_wt" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_jewelry_order_pivot_customer" model="ir.ui.view">
        <field name="name">custom.jewelry.order.pivot.customer</field>
        <field name="model">custom.jewelry.order</field>
        <field name="arch" type="xml">
            <pivot string="Customer Analysis" disable_linking="0">
                <field name="partner_id" type="row"/>
                <field name="date_order" interval="month" type="col"/>
                <field name="total_wt" type="measure"/>
                <field name="pieces" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ============================================================ -->
