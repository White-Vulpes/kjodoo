<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Single-page analytics dashboard: every graph tiled on one screen.
         Implemented as an OWL client action (see static/src/js/analytics_dashboard.js)
         so it is read-only and needs no per-user board customization records. -->
    <record id="action_jewelry_dashboard_client" model="ir.actions.client">
        <field name="name">Analytics</field>
        <field name="tag">jewelry_analytics_dashboard</field>
    </record>

    <menuitem id="menu_jewelry_analytics_dashboard"
              name="Analytics"
              parent="menu_custom_jewelry_root"
              action="action_jewelry_dashboard_client"
              sequence="50"/>
</odoo>
