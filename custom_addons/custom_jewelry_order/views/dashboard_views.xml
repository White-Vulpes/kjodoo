<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LIST VIEW: Recent portal visits -->
    <record id="view_jewelry_order_visit_list" model="ir.ui.view">
        <field name="name">jewelry.order.visit.list</field>
        <field name="model">jewelry.order.visit</field>
        <field name="arch" type="xml">
            <list string="Portal Visits" default_order="visit_date desc" create="0" delete="0">
                <field name="visit_date"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="manufacturer_id"/>
                <field name="ip_address"/>
            </list>
        </field>
    </record>

    <!-- GRAPH VIEW: Visits over time (line chart) -->
    <record id="view_jewelry_order_visit_graph" model="ir.ui.view">
        <field name="name">jewelry.order.visit.graph</field>
        <field name="model">jewelry.order.visit</field>
        <field name="arch" type="xml">
            <graph string="Portal Visits Over Time" type="line">
                <field name="visit_date" interval="day" type="row"/>
            </graph>
        </field>
    </record>

    <!-- PIVOT VIEW: Visit breakdown -->
    <record id="view_jewelry_order_visit_pivot" model="ir.ui.view">
        <field name="name">jewelry.order.visit.pivot</field>
        <field name="model">jewelry.order.visit</field>
        <field name="arch" type="xml">
            <pivot string="Visit Analysis" disable_linking="0">
                <field name="order_id" type="row"/>
                <field name="visit_date" interval="month" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- SEARCH VIEW: Visit filters -->
    <record id="view_jewelry_order_visit_search" model="ir.ui.view">
        <field name="name">jewelry.order.visit.search</field>
        <field name="model">jewelry.order.visit</field>
        <field name="arch" type="xml">
            <search string="Search Visits">
                <field name="order_id" string="Order"/>
                <field name="partner_id" string="Customer"/>
                <field name="manufacturer_id" string="Manufacturer"/>
                <filter string="Visit Date" name="this_month" date="visit_date"/>
                <group>
                    <filter string="Order" name="group_order" context="{'group_by': 'order_id'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Manufacturer" name="group_manufacturer" context="{'group_by': 'manufacturer_id'}"/>
                    <filter string="Day" name="group_day" context="{'group_by': 'visit_date:day'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'visit_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION: Portal Visits -->
    <record id="action_jewelry_order_visit" model="ir.actions.act_window">
        <field name="name">Portal Visits</field>
        <field name="res_model">jewelry.order.visit</field>
        <field name="view_mode">graph,pivot,list</field>
    </record>

    <!-- MENU: Portal Visits (must be here, after action is defined) -->
    <menuitem id="menu_analytics_portal_visits" name="Portal Visits" parent="menu_jewelry_analytics" action="action_jewelry_order_visit" sequence="20"/>
</odoo>
