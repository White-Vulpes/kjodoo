<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- LIST VIEW: Recent portal visits -->
    <record id="view_jewelry_order_visit_list" model="ir.ui.view">
        <field name="name">jewelry.order.visit.list</field>
        <field name="model">jewelry.order.visit</field>
        <field name="arch" type="xml">
            <list string="Portal Visits" default_order="visit_date desc" create="0" delete="0">
                <field name="visit_date"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="manufacturer_id"/>
                <field name="ip_address"/>
            </list>
        </field>
    </record>

    <!-- GRAPH VIEW: Visits over time (line chart) -->
    <record id="view_jewelry_order_visit_graph" model="ir.ui.view">
        <field name="name">jewelry.order.visit.graph</field>
        <field name="model">jewelry.order.visit</field>
        <field name="arch" type="xml">
            <graph string="Portal Visits Over Time" type="line">
                <field name="visit_date" interval="day" type="row"/>
            </graph>
        </field>
    </record>

    <!-- PIVOT VIEW: Visit breakdown -->
    <record id="view_jewelry_order_visit_pivot" model="ir.ui.view">
        <field name="name">jewelry.order.visit.pivot</field>
        <field name="model">jewelry.order.visit</field>
        <field name="arch" type="xml">
            <pivot string="Visit Analysis" disable_linking="0">
                <field name="order_id" type="row"/>
                <field name="visit_date" interval="month" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- SEARCH VIEW: Visit filters -->
    <record id="view_jewelry_order_visit_search" model="ir.ui.view">
        <field name="name">jewelry.order.visit.search</field>
        <field name="model">jewelry.order.visit</field>
        <field name="arch" type="xml">
            <search string="Search Visits">
                <field name="order_id" string="Order"/>
                <field name="partner_id" string="Customer"/>
                <field name="manufacturer_id" string="Manufacturer"/>
                <filter string="Visit Date" name="this_month" date="visit_date"/>
                <group>
                    <filter string="Order" name="group_order" context="{'group_by': 'order_id'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Manufacturer" name="group_manufacturer" context="{'group_by': 'manufacturer_id'}"/>
                    <filter string="Day" name="group_day" context="{'group_by': 'visit_date:day'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'visit_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- GRAPH VIEW: Visits by Customer (engagement bar chart) -->
    <record id="view_jewelry_order_visit_graph_partner" model="ir.ui.view">
        <field name="name">jewelry.order.visit.graph.partner</field>
        <field name="model">jewelry.order.visit</field>
        <field name="arch" type="xml">
            <graph string="Visits by Customer" type="bar">
                <field name="partner_id" type="row"/>
            </graph>
        </field>
    </record>

    <!-- ACTION: Portal Visits (traffic over time) -->
    <record id="action_jewelry_order_visit" model="ir.actions.act_window">
        <field name="name">Portal Visits</field>
        <field name="res_model">jewelry.order.visit</field>
        <field name="view_mode">graph,pivot,list</field>
    </record>

    <!-- ACTION: Customer Engagement (visits grouped by customer) -->
    <record id="action_jewelry_customer_engagement" model="ir.actions.act_window">
        <field name="name">Customer Engagement</field>
        <field name="res_model">jewelry.order.visit</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="context">{'search_default_group_partner': 1}</field>
    </record>
    <record id="action_jewelry_customer_engagement_view_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_jewelry_order_visit_graph_partner"/>
        <field name="act_window_id" ref="action_jewelry_customer_engagement"/>
    </record>
    <record id="action_jewelry_customer_engagement_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_jewelry_order_visit_pivot"/>
        <field name="act_window_id" ref="action_jewelry_customer_engagement"/>
    </record>
    <record id="action_jewelry_customer_engagement_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_jewelry_order_visit_list"/>
        <field name="act_window_id" ref="action_jewelry_customer_engagement"/>
    </record>

    <!-- ============================================================ -->
    <!-- I. DESIGN SHOWCASE CAROUSEL INTERACTIONS                     -->
    <!-- ============================================================ -->
    <record id="view_jewelry_carousel_interaction_list" model="ir.ui.view">
        <field name="name">jewelry.carousel.interaction.list</field>
        <field name="model">jewelry.carousel.interaction</field>
        <field name="arch" type="xml">
            <list string="Design Showcase Views" default_order="interaction_date desc" create="0" delete="0">
                <field name="interaction_date"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="collection_id"/>
                <field name="slide_index"/>
                <field name="ip_address"/>
            </list>
        </field>
    </record>

    <record id="view_jewelry_carousel_interaction_graph" model="ir.ui.view">
        <field name="name">jewelry.carousel.interaction.graph</field>
        <field name="model">jewelry.carousel.interaction</field>
        <field name="arch" type="xml">
            <graph string="Views by Collection" type="bar">
                <field name="collection_id" type="row"/>
            </graph>
        </field>
    </record>

    <record id="view_jewelry_carousel_interaction_graph_slide" model="ir.ui.view">
        <field name="name">jewelry.carousel.interaction.graph.slide</field>
        <field name="model">jewelry.carousel.interaction</field>
        <field name="arch" type="xml">
            <graph string="Views by Slide Position" type="bar">
                <field name="slide_index" type="row"/>
            </graph>
        </field>
    </record>

    <record id="view_jewelry_carousel_interaction_pivot" model="ir.ui.view">
        <field name="name">jewelry.carousel.interaction.pivot</field>
        <field name="model">jewelry.carousel.interaction</field>
        <field name="arch" type="xml">
            <pivot string="Showcase Engagement" disable_linking="0">
                <field name="collection_id" type="row"/>
                <field name="interaction_date" interval="month" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_jewelry_carousel_interaction_search" model="ir.ui.view">
        <field name="name">jewelry.carousel.interaction.search</field>
        <field name="model">jewelry.carousel.interaction</field>
        <field name="arch" type="xml">
            <search string="Search Showcase Views">
                <field name="order_id" string="Order"/>
                <field name="partner_id" string="Customer"/>
                <field name="collection_id" string="Collection"/>
                <filter string="Viewed Date" name="filter_date" date="interaction_date"/>
                <group>
                    <filter string="Collection" name="group_collection" context="{'group_by': 'collection_id'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Slide Position" name="group_slide" context="{'group_by': 'slide_index'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'interaction_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_jewelry_carousel_interaction" model="ir.actions.act_window">
        <field name="name">Design Showcase Views</field>
        <field name="res_model">jewelry.carousel.interaction</field>
        <field name="view_mode">graph,pivot,list</field>
    </record>

    <!-- These actions are surfaced on the single Analytics dashboard
         (see analytics_dashboard.xml); no individual menus needed. -->
</odoo>
