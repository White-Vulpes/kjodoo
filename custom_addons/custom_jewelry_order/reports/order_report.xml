<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Custom Paper Format for A6 Pocket Size -->
    <record id="paperformat_a6_jewelry" model="report.paperformat">
        <field name="name">A6 Jewelry Job Card</field>
        <field name="default" eval="True"/>
        <field name="format">A6</field>
        <field name="orientation">Landscape</field>
        <!-- Very tight margins to maximize the small space -->
        <field name="margin_top">1</field>
        <field name="margin_bottom">1</field>
        <field name="margin_left">1</field>
        <field name="margin_right">1</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
    </record>

    <!-- 2. The Print Action (Linked to the A6 Format) -->
    <record id="action_report_custom_jewelry_order" model="ir.actions.report">
        <field name="name">A6 Job Card</field>
        <field name="model">custom.jewelry.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_jewelry_order.report_jewelry_order_document</field>
        <field name="report_file">custom_jewelry_order.report_jewelry_order_document</field>
        <field name="binding_model_id" ref="model_custom_jewelry_order"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Job Card - %s' % (object.name)</field>
        <!-- Points to our new A6 paper format -->
        <field name="paperformat_id" ref="paperformat_a6_jewelry"/> 
    </record>

    <template id="report_jewelry_order_document">
        <t t-call="web.html_container">
            <!-- Basic layout removes standard Odoo headers/footers -->
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="doc">
                    
                    <!-- Base Page with Studio's font and padding -->
                    <div class="page" style="font-family: sans-serif;">
                        
                        <!-- Main Container Table (Replaces Studio's complex xpath) -->
                        <table style="width: 100%; border-collapse: collapse; table-layout: fixed;">
                            <tr>
                                
                                <!-- ==========================================
                                     LEFT COLUMN: 40% Text Details
                                     ========================================== -->
                                <td style="width: 40%; border-right: 1px solid #dee2e6; background-color: #fcfcfc; padding: 15px; vertical-align: top;">
                                    
                                    <!-- Studio Maroon Header -->
                                    <h4 style="color: #714B67; border-bottom: 2px solid #714B67; padding-bottom: 5px; margin-bottom: 15px; font-size: 16px;">
                                        Order Details: <span t-field="doc.name"/>
                                    </h4>
                                    
                                    <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
                                        <tr>
                                            <td style="padding: 6px 0; font-weight: bold; color: #555; width: 40%;">Date:</td>
                                            <td style="padding: 6px 0;"><span t-field="doc.date_order" t-options='{"widget": "date"}'/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 6px 0; font-weight: bold; color: #555;">Item Type:</td>
                                            <td style="padding: 6px 0;"><span t-field="doc.item_type.name"/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 6px 0; font-weight: bold; color: #555;">Weight:</td>
                                            <td style="padding: 6px 0;"><span t-field="doc.weight"/> x <span t-field="doc.pieces"/> = <span t-field="doc.total_wt"/>g</td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 6px 0; font-weight: bold; color: #555;">Melting:</td>
                                            <td style="padding: 6px 0;"><span t-field="doc.melting_id.name"/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 6px 0; font-weight: bold; color: #555;">Size:</td>
                                            <td style="padding: 6px 0;"><span t-field="doc.size_id.name"/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 6px 0; font-weight: bold; color: #555;">Seal:</td>
                                            <td style="padding: 6px 0;"><span t-field="doc.seal.name"/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 6px 0; font-weight: bold; color: #555;">Broadness:</td>
                                            <td style="padding: 6px 0;"><span t-field="doc.broadness_id.name"/></td>
                                        </tr>
                                        <tr>
                                            <td colspan="2" style="padding: 0 0 10px 0;">
                                                <span t-field="doc.description" style="white-space: pre-wrap; color: #db0404;"/>
                                            </td>
                                        </tr>
                                    </table>
                                </td>

                                <!-- ==========================================
                                     RIGHT COLUMN: 60% Image Gallery
                                     ========================================== -->
                                <td style="width: 60%; background-color: #ffffff; padding: 10px; vertical-align: top;">
                                    
                                    <!-- Max 4 Photos -->
                                    <t t-set="photo_list" t-value="doc.reference_image_ids[:4]"/>
                                    <t t-set="total_photos" t-value="len(photo_list)"/>
                                    
                                    <div style="width: 100%;">
                                        <t t-foreach="photo_list" t-as="img">
                                            
                                            <!-- Dynamic Width: 100% if single photo, 50% if multiple -->
                                            <div t-att-style="'float: left; padding: 4px; box-sizing: border-box; ' + ('width: 100%;' if total_photos == 1 else 'width: 50%;')">
                                                
                                                <!-- Dynamic Height: 350px if single photo, 160px if multiple -->
                                                <div t-att-style="'border: 1px solid #f0f0f0; background-color: #fafafa; display: block; overflow: hidden; text-align: center; ' + ('height: 350px; line-height: 350px;' if total_photos == 1 else 'height: 160px; line-height: 160px;')">
                                                    
                                                    <img t-if="img.datas" t-att-src="image_data_uri(img.datas)" style="max-width: 98%; max-height: 98%; vertical-align: middle; display: inline-block;"/>
                                                
                                                </div>
                                            </div>
                                        </t>
                                        <div style="clear: both;"/>
                                    </div>

                                    <!-- Fallback if no photos exist -->
                                    <t t-if="total_photos == 0">
                                        <div style="text-align: center; padding: 40px; color: #999;">
                                            <p><em>No images attached.</em></p>
                                        </div>
                                    </t>
                                </td>

                            </tr>
                        </table>
                    </div> 
                    <!-- End Page -->
                    
                </t>
            </t>
        </t>
    </template>
</odoo>