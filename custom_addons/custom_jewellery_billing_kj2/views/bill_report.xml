<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_custom_bill_a6" model="report.paperformat">
        <field name="name">A6 Paper</field>
        <field name="default" eval="False"/>
        <field name="format">A6</field>

        <field name="orientation">Landscape</field>

        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>

        <field name="dpi">90</field>
    </record>
    
    <record id="action_report_custom_bill" model="ir.actions.report">
        <field name="name">Jewelry Bill</field>
        <field name="model">custom.bill2</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_jewellery_billing_kj2.report_custom_bill</field>
        <field name="report_file">custom_jewellery_billing_kj2.report_custom_bill</field>
        <field name="binding_model_id" ref="model_custom_bill2"/>
        <field name="binding_type">report</field>

        <field name="print_report_name">'Bill - %s' % (object.name)</field>
        <field name="paperformat_id" ref="custom_jewellery_billing_kj2.paperformat_custom_bill_a6"/>
    </record>
    <record id="action_report_custom_bill_retail" model="ir.actions.report">
        <field name="name">Retail Jewelry Bill</field>
        <field name="model">custom.bill2</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_jewellery_billing_kj2.report_custom_bill_retail</field>
        <field name="report_file">custom_jewellery_billing_kj2.report_custom_bill_retail</field>
        <field name="binding_model_id" ref="model_custom_bill2"/>
        <field name="binding_type">report</field>

        <field name="print_report_name">'Retail Bill - %s' % (object.name)</field>
        <field name="paperformat_id" ref="custom_jewellery_billing_kj2.paperformat_custom_bill_a6"/>
    </record>
    <template id="report_custom_bill_retail">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="doc">
                    <div class="page w-100" style="font-size: 0.9em;">

                        <div style="text-align:center;">
                            ||SHREE||
                            <br/>
                            <strong>Rough Estimate / On Approval</strong>
                        </div>

                        <div class="row mt-2">
                            <div class="col-8">
                                <h5>
                                    <span t-field="doc.bill_number"/> -
                                    <span t-field="doc.partner_id"/>
                                </h5>
                            </div>
                            <div class="col-4 text-end">
                                Date: <span t-field="doc.date" t-options='{"widget": "date", "format": "dd/MM"}'/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <span style="font-style: italic; font-size: 0.8em;">Phone: <span t-field="doc.partner_id.phone"/></span>
                            </div>
                            <div class="col-6 text-end">
                                <span style="font-style: italic; font-size: 0.8em;">
                                    22K: <span t-field="doc.karat_22" t-options='{"widget": "float", "precision": 2}'/> | 
                                    18K: <span t-field="doc.karat_18" t-options='{"widget": "float", "precision": 2}'/>
                                </span>
                            </div>
                        </div>
                        <table class="table table-sm table-bordered mb-0" style="font-size: 0.9em; border-collapse: collapse;">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th class="text-end">Weight</th>
                                    <th class="text-end">Less</th>
                                    <th class="text-end">Nt. Wt</th>
                                    <th class="text-end">Charges</th>
                                    <th class="text-end">VA</th>
                                    <th class="text-end">Wt. + VA</th>
                                    <th class="text-end">Cash</th>
                                </tr>
                            </thead>

                            <tbody>
                                <t t-foreach="doc.item_ids" t-as="line">
                                    <tr>
                                        <td><span t-field="line.type"/>: <span t-field="line.name"/></td>
                                        <td class="text-end"><span t-field="line.weight" t-options='{"widget": "float", "precision": 3}'/></td>
                                        <td class="text-end"><span t-field="line.less" t-options='{"widget": "float", "precision": 3}'/></td>
                                        <td class="text-end"><span t-field="line.net_weight" t-options='{"widget": "float", "precision": 3}'/></td>
                                        <td class="text-end"><span t-field="line.charges" t-options='{"widget": "float", "precision": 2}'/></td>
                                        <td class="text-end"><span t-field="line.VAT"/></td>
                                        <td class="text-end"><span t-field="line.total_wt" t-options='{"widget": "float", "precision": 3}'/></td>
                                        <td class="text-end"><span t-field="line.cash" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                </t>

                                <!-- Subtotal Row -->
                                <tr class="fw-bold" style="background-color: #f0f0f0;">
                                    <td>Total</td>
                                    <td class="text-end"><span t-field="doc.total_weight" t-options='{"widget": "float", "precision": 3}'/></td>
                                    <td class="text-end"><span t-field="doc.total_less" t-options='{"widget": "float", "precision": 3}'/></td>
                                    <td class="text-end"><span t-field="doc.total_net_weight" t-options='{"widget": "float", "precision": 3}'/></td>
                                    <td/>
                                    <td/>
                                    <td class="text-end"><span t-field="doc.total_wt" t-options='{"widget": "float", "precision": 3}'/></td>
                                    <td class="text-end"><span t-field="doc.total_cash" t-options='{"widget": "float", "precision": 2}'/></td>
                                </tr>

                                <!-- NEW: GST Row -->
                                <tr style="border: none;">
                                    <td colspan="4" class="pt-2 pe-3" style="border: none; font-size: 1em; font-weight: 500;">No Return / No Exchange After Delivery</td>
                                    <td colspan="3" class="text-end border-0 pt-2 pe-3">GST (3%):</td>
                                    <td class="text-end border-0 pt-2">
                                        <!-- Calculates 3% dynamically -->
                                        <span t-esc="doc.total_cash * 0.03" t-options='{"widget": "float", "precision": 2}'/>
                                    </td>
                                </tr>

                                <!-- NEW: Grand Total Row -->
                                <tr class="fw-bold" style="border: none; font-size: 1.1em;">
                                    <td colspan="7" class="text-end border-0 pe-3">Grand Total:</td>
                                    <td class="text-end border-0" style="border-top: 1px solid #000 !important; border-bottom: 2px solid #000 !important;">
                                        <!-- Calculates Cash + 3% dynamically -->
                                        <span t-esc="doc.total_cash * 1.03" t-options='{"widget": "float", "precision": 2}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <t t-if="doc.transaction_ids and doc.show_transaction">
                            <table class="table table-sm table-bordered mt-2 mb-0" style="font-size: 0.9em; font-style: italic;">
                                <thead>
                                    <tr style="background-color: #f8f9fa;">
                                        <th>Date</th>
                                        <th>Type</th>
                                        <th class="text-end">Wt.</th>
                                        <th class="text-end">Purity</th>
                                        <th class="text-end">Pure</th>
                                        <th class="text-end">Rate</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.transaction_ids" t-as="txn">
                                        <tr>
                                            <td><span t-field="txn.date" t-options='{"widget": "date", "format": "dd/MM"}'/></td>
                                            <td>
                                                <span t-if="txn.ttype == 'metal_recv'">Metal Received</span>
                                                <span t-if="txn.ttype == 'metal_pay'">Metal Payment</span>
                                                <span t-if="txn.ttype == 'cash_recv'">Cash Received</span>
                                                <span t-if="txn.ttype == 'cash_pay'">Cash Payment</span>
                                                <span t-if="txn.ttype == 'rate_cut'">Rate Cut</span>
                                                <span t-if="txn.ttype == 'old_item'">Old Item</span>
                                                <span t-if="txn.ttype == 'return_item'">Return Item</span>
                                            </td>
                                            <td class="text-end">
                                                <span t-if="txn.ttype in ('metal_recv', 'metal_pay', 'old_item', 'return_item')" t-field="txn.net_weight" t-options='{"widget": "float", "precision": 3}'/>
                                            </td>
                                            <td class="text-end">
                                                <span t-if="txn.ttype in ('metal_recv', 'metal_pay', 'return_item')" t-field="txn.purity" t-options='{"widget": "float", "precision": 2}'/>
                                            </td>
                                            <td class="text-end">
                                                <span t-if="txn.ttype in ('metal_recv', 'metal_pay', 'rate_cut', 'return_item')" t-field="txn.pure_weight" t-options='{"widget": "float", "precision": 3}'/>
                                            </td>
                                            <td class="text-end">
                                                <t t-if="txn.ttype == 'rate_cut'">
                                                    <span t-field="txn.rate" t-options='{"widget": "float", "precision": 2}'/>
                                                </t>
                                                <t t-if="txn.ttype == 'old_item'">
                                                    <span t-esc="txn.rate * txn.purity / 100" t-options='{"widget": "float", "precision": 2}'/>
                                                </t>
                                            </td>
                                            <td class="text-end">
                                                <span t-if="txn.ttype in ('cash_recv', 'cash_pay', 'rate_cut', 'old_item')" t-field="txn.amount" t-options='{"widget": "float", "precision": 2}'/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-if="doc.remarks">
                            <div class="row mt-3">
                                <div class="col-12" style="font-size: 0.9em;">
                                    <strong>Remarks:</strong>
                                    <span t-field="doc.remarks"/>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
    <template id="report_custom_bill">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="doc">
                    <div class="page w-100" style="font-size: 0.9em;">

                        <div style="text-align:center;">
                            ||SHREE||
                            <br/>
                            <strong>Rough Estimate / On Approval</strong>
                        </div>

                        <div class="row mt-2 mb-3">
                            <div class="col-8">
                                <h5>
                                    <span t-field="doc.bill_number"/> -
                                    <span t-field="doc.partner_id"/>
                                </h5>
                            </div>
                            <div class="col-4 text-end">
                                Date:
                                <span t-field="doc.date" t-options='{"widget": "date", "format": "dd/MM"}'/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <span style="font-style: italic; font-size: 0.8em;">Phone: <span t-field="doc.partner_id.phone"/></span>
                            </div>
                            <div class="col-6 text-end">
                                <span style="font-style: italic; font-size: 0.8em;">
                                    24K: <span t-field="doc.karat_24" t-options='{"widget": "float", "precision": 2}'/>
                                </span>
                            </div>
                        </div>
                        <table class="table table-sm table-bordered mb-0" style="font-size: 0.9em;">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th class="text-end">Weight</th>
                                    <th class="text-end">Less</th>
                                    <th class="text-end">Nt. Wt</th>
                                    <th class="text-end">Melting</th>
                                    <th class="text-end">Touch</th>
                                    <th class="text-end">Pure</th>
                                    <th class="text-end">Charges</th>
                                </tr>
                            </thead>

                            <tbody>
                                <t t-foreach="doc.item_ids" t-as="line">
                                    <tr>
                                        <td><span t-field="line.name"/></td>
                                        
                                        <td class="text-end"><span t-field="line.weight" t-options='{"widget": "float", "precision": 3}'/></td>
                                        <td class="text-end"><span t-field="line.less" t-options='{"widget": "float", "precision": 3}'/></td>
                                        <td class="text-end"><span t-field="line.net_weight" t-options='{"widget": "float", "precision": 3}'/></td>
                                        
                                        <td class="text-end"><span t-field="line.melting"/></td>
                                        <td class="text-end"><span t-field="line.touch"/></td>
                                        
                                        <td class="text-end"><span t-field="line.pure" t-options='{"widget": "float", "precision": 3}'/></td>
                                        <td class="text-end"><span t-field="line.charges" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                </t>

                                <tr class="fw-bold" style="background-color: #f0f0f0;">
                                    <td>Total</td>
                                    <td class="text-end"><span t-field="doc.total_weight" t-options='{"widget": "float", "precision": 3}'/></td>
                                    <td class="text-end"><span t-field="doc.total_less" t-options='{"widget": "float", "precision": 3}'/></td>
                                    <td class="text-end"><span t-field="doc.total_net_weight" t-options='{"widget": "float", "precision": 3}'/></td>
                                    <td/>
                                    <td/>
                                    <td class="text-end"><span t-field="doc.total_pure" t-options='{"widget": "float", "precision": 3}'/></td>
                                    <td class="text-end"><span t-field="doc.total_charges" t-options='{"widget": "float", "precision": 2}'/></td>
                                </tr>
                            </tbody>
                        </table>
                        <t t-if="doc.transaction_ids and doc.show_transaction">
                            <table class="table table-sm table-bordered mt-2 mb-0" style="font-size: 0.9em; font-style: italic;">
                                <thead>
                                    <tr style="background-color: #f8f9fa;">
                                        <th>Date</th>
                                        <th>Type</th>
                                        <th class="text-end">Wt.</th>
                                        <th class="text-end">Purity</th>
                                        <th class="text-end">Pure</th>
                                        <th class="text-end">Rate</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.transaction_ids" t-as="txn">
                                        <tr>
                                            <td><span t-field="txn.date" t-options='{"widget": "date", "format": "dd/MM"}'/></td>
                                            <td>
                                                <span t-if="txn.ttype == 'metal_recv'">Metal Received</span>
                                                <span t-if="txn.ttype == 'metal_pay'">Metal Payment</span>
                                                <span t-if="txn.ttype == 'cash_recv'">Cash Received</span>
                                                <span t-if="txn.ttype == 'cash_pay'">Cash Payment</span>
                                                <span t-if="txn.ttype == 'rate_cut'">Rate Cut</span>
                                                <span t-if="txn.ttype == 'old_item'">Old Item</span>
                                                <span t-if="txn.ttype == 'return_item'">Return Item</span>
                                            </td>
                                            <td class="text-end">
                                                <span t-if="txn.ttype in ('metal_recv', 'metal_pay', 'old_item', 'return_item')" t-field="txn.net_weight" t-options='{"widget": "float", "precision": 3}'/>
                                            </td>
                                            <td class="text-end">
                                                <span t-if="txn.ttype in ('metal_recv', 'metal_pay', 'old_item', 'return_item')" t-field="txn.purity" t-options='{"widget": "float", "precision": 2}'/>
                                            </td>
                                            <td class="text-end">
                                                <span t-if="txn.ttype in ('metal_recv', 'metal_pay', 'rate_cut', 'old_item', 'return_item')" t-field="txn.pure_weight" t-options='{"widget": "float", "precision": 3}'/>
                                            </td>
                                            <td class="text-end">
                                                <span t-if="txn.ttype in ('rate_cut', 'old_item')" t-field="txn.rate" t-options='{"widget": "float", "precision": 2}'/>
                                            </td>
                                            <td class="text-end">
                                                <span t-if="txn.ttype in ('cash_recv', 'cash_pay', 'rate_cut', 'old_item')" t-field="txn.amount" t-options='{"widget": "float", "precision": 2}'/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <div class="w-100 text-end m-0" style="display: flex !important; justify-content: space-between !important;">
                            <span style="font-size: 0.8em; font-weight: 500;">No Return / No Exchange After Delivery</span>
                            <span style="font-style: italic; font-size: 0.8em;">*GST as applicable</span>
                        </div>
                        <t t-if="doc.remarks">
                            <div class="row mt-1">
                                <div class="col-12" style="font-size: 0.9em;">
                                    <strong>Remarks:</strong>
                                    <span t-field="doc.remarks"/>
                                </div>
                            </div>
                        </t>
                        <t t-if="len(doc.transaction_ids) > 0">
                            <div class="row mt-1">
                                <div style="font-size: 0.9em;">
                                    <strong>Pure: </strong> <span t-field="doc.balance_pure" t-options='{"widget": "float", "precision": 3}'/>
                                    <span style="margin-left: 20px;"/>
                                    <strong>Cash: </strong> <span t-field="doc.balance_charges" t-options='{"widget": "float", "precision": 2}'/>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>