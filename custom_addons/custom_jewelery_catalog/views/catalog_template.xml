<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="jewelry_public_catalog" name="Jewelry Catalog">
        <t t-call="website.layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>

            <style>
                @import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&amp;display=swap');

                /* ── Full-width breakout (same trick as order detail page) ── */
                #catalog-breakout {
                    width: 100vw;
                    position: relative;
                    left: 50%;
                    transform: translateX(-50%);
                    background-color: #fafbfc;
                    min-height: 100vh;
                    font-family: 'Quicksand', sans-serif;
                    padding-bottom: 5rem;
                }
                #catalog-breakout * { font-family: 'Quicksand', sans-serif !important; }

                /* ── Sticky header ── */
                #catalog-header {
                    background: #ffffff;
                    border-bottom: 1px solid #f1f3f5;
                    padding: 1.5rem 2.5rem 1.25rem;
                    position: sticky;
                    top: 0;
                    z-index: 100;
                    box-shadow: 0 2px 12px rgba(0,0,0,0.03);
                }
                #catalog-header h1 {
                    font-size: 0.75rem;
                    font-weight: 700;
                    letter-spacing: 1.5px;
                    text-transform: uppercase;
                    color: #94a3b8;
                    margin: 0 0 1rem;
                }

                /* ── Filter bar ── */
                #filter-form {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 10px;
                    align-items: center;
                }
                #filter-form input,
                #filter-form select {
                    border: 1px solid #f1f3f5;
                    border-radius: 12px;
                    padding: 8px 14px;
                    font-size: 0.82rem;
                    font-family: 'Quicksand', sans-serif !important;
                    color: #1e293b;
                    background: #f8f9fa;
                    outline: none;
                    transition: border-color 0.2s, box-shadow 0.2s;
                }
                #filter-form input:focus,
                #filter-form select:focus {
                    border-color: #adb5bd;
                    box-shadow: 0 0 0 3px rgba(0,0,0,0.04);
                }
                #filter-form .search-input { flex: 1 1 220px; min-width: 160px; }
                #filter-form .weight-group {
                    display: flex;
                    align-items: center;
                    gap: 6px;
                    font-size: 0.78rem;
                    color: #94a3b8;
                    font-weight: 600;
                    letter-spacing: 0.5px;
                }
                #filter-form .weight-group input { width: 80px; }
                #filter-form button[type="submit"] {
                    background: #212529;
                    color: #fff;
                    border: none;
                    border-radius: 12px;
                    padding: 9px 24px;
                    font-size: 0.78rem;
                    font-weight: 700;
                    letter-spacing: 1px;
                    text-transform: uppercase;
                    cursor: pointer;
                    font-family: 'Quicksand', sans-serif !important;
                    transition: background 0.2s;
                }
                #filter-form button[type="submit"]:hover { background: #0f172a; }

                /* ── Select2 overrides to match theme ── */
                .select2-container { caret-color: transparent !important; }
                .select2-container .select2-search--inline .select2-search__field {
                    margin-top: 0 !important; display: none !important;
                }
                .select2-container--default .select2-selection--multiple {
                    background: #f8f9fa !important;
                    border: 1px solid #f1f3f5 !important;
                    border-radius: 12px !important;
                    min-height: 38px !important;
                    padding: 3px 8px !important;
                }
                .select2-container--default .select2-selection--multiple .select2-selection__choice {
                    background: #e9ecef !important;
                    color: #1e293b !important;
                    border: none !important;
                    border-radius: 20px !important;
                    font-size: 0.72rem !important;
                    font-weight: 600 !important;
                    padding: 2px 10px !important;
                    margin: 2px !important;
                }
                .select2-container--default .select2-selection--multiple .select2-selection__clear { display: none !important; }
                .select2-container--default .select2-selection--multiple .select2-selection__choice__remove {
                    color: #94a3b8 !important; border: none !important;
                }
                .select2-container--default .select2-selection--multiple .select2-selection__choice__remove:hover {
                    color: #c0392b !important; background: transparent !important;
                }

                /* ── Item grid ── */
                #catalog-grid {
                    display: grid;
                    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
                    gap: 1.5rem;
                    padding: 2rem 2.5rem;
                }

                /* ── Item card ── */
                .item-card {
                    background: #ffffff;
                    border: none;
                    border-radius: 24px;
                    box-shadow: 0 10px 40px rgba(0,0,0,0.04);
                    overflow: hidden;
                    display: flex;
                    flex-direction: column;
                    cursor: pointer;
                    transition: box-shadow 0.2s, transform 0.2s;
                }
                .item-card:hover {
                    box-shadow: 0 16px 48px rgba(0,0,0,0.09);
                    transform: translateY(-2px);
                }
                .item-card.selected {
                    box-shadow: 0 0 0 2px #212529, 0 16px 48px rgba(0,0,0,0.09);
                }

                /* Force Odoo image widget to fill a fixed-height crop box */
                .item-card .item-card-img {
                    display: block;
                    width: 100%;
                    height: 240px;
                    overflow: hidden;
                }
                .item-card .item-card-img img {
                    width: 100% !important;
                    height: 100% !important;
                    max-width: 100% !important;
                    object-fit: cover !important;
                }

                @media (max-width: 768px) {
                    .item-card .item-card-img { height: 160px; }
                }

                .item-card-body {
                    padding: 1.25rem 1.25rem 0.75rem;
                    flex: 1;
                }
                .item-card-body .spec-label {
                    font-size: 0.7rem;
                    letter-spacing: 1.5px;
                    text-transform: uppercase;
                    color: #94a3b8;
                    font-weight: 700;
                    display: block;
                    margin-bottom: 0.15rem;
                }
                .item-name {
                    font-size: 1rem;
                    font-weight: 700;
                    color: #0f172a;
                    margin-bottom: 0.25rem;
                    line-height: 1.3;
                }
                .item-id {
                    font-size: 0.75rem;
                    color: #94a3b8;
                    font-weight: 600;
                    letter-spacing: 0.5px;
                    margin-bottom: 0.85rem;
                }
                .item-specs {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 0.75rem;
                    margin-bottom: 0.75rem;
                }
                .item-specs .spec-block { min-width: 0; }
                .item-specs .spec-value {
                    font-size: 0.95rem;
                    font-weight: 600;
                    color: #1e293b;
                }
                .item-tags {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 4px;
                    margin-top: 0.5rem;
                }
                .item-tag {
                    background: #f1f3f5;
                    color: #64748b;
                    font-size: 0.68rem;
                    font-weight: 700;
                    letter-spacing: 0.8px;
                    padding: 3px 10px;
                    border-radius: 20px;
                    text-transform: uppercase;
                }

                .item-card-footer {
                    padding: 0.75rem 1.25rem 1.25rem;
                }
                .select-btn {
                    width: 100%;
                    background: transparent;
                    border: 1.5px solid #e9ecef;
                    border-radius: 12px;
                    padding: 8px;
                    font-size: 0.75rem;
                    font-weight: 700;
                    letter-spacing: 1px;
                    text-transform: uppercase;
                    font-family: 'Quicksand', sans-serif !important;
                    color: #64748b;
                    cursor: pointer;
                    transition: all 0.15s;
                }
                .select-btn:hover { border-color: #212529; color: #212529; }
                .select-btn.active {
                    background: #212529;
                    border-color: #212529;
                    color: #fff;
                }

                /* ── Floating cart ── */
                #floating-cart {
                    position: fixed;
                    bottom: 32px;
                    right: 32px;
                    z-index: 1050;
                    display: none;
                }
                #submit-inquiry-btn {
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    background: #212529;
                    color: #fff;
                    border: none;
                    border-radius: 40px;
                    padding: 14px 26px;
                    font-size: 0.78rem;
                    font-weight: 700;
                    letter-spacing: 1px;
                    text-transform: uppercase;
                    font-family: 'Quicksand', sans-serif !important;
                    text-decoration: none;
                    box-shadow: 0 4px 24px rgba(0,0,0,0.18);
                    transition: background 0.2s;
                }
                #submit-inquiry-btn:hover { background: #0f172a; color: #fff; }
                #cart-count-badge {
                    background: #fff;
                    color: #212529;
                    border-radius: 50%;
                    width: 22px;
                    height: 22px;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 0.72rem;
                    font-weight: 700;
                }

                /* ── Empty state ── */
                #empty-state {
                    text-align: center;
                    padding: 80px 20px;
                    color: #94a3b8;
                    font-size: 1rem;
                    font-weight: 500;
                    letter-spacing: 0.5px;
                }

                @media (max-width: 768px) {
                    #catalog-header { padding: 1rem 1rem 0.85rem; }
                    #catalog-grid {
                        grid-template-columns: repeat(2, 1fr);
                        gap: 0.75rem;
                        padding: 1rem;
                    }
                    .item-card { border-radius: 16px; }
                }

                @media (max-width: 400px) {
                    .item-card-body { padding: 0.75rem 0.75rem 0.5rem; }
                    .item-name { font-size: 0.85rem; }
                    .item-id { font-size: 0.65rem; margin-bottom: 0.5rem; }
                    .item-specs .spec-value { font-size: 0.8rem; }
                }
            </style>

            <div id="catalog-breakout">

                <div id="catalog-header">
                    <h1>Collection</h1>
                    <form id="filter-form" action="/catalog" method="get">
                        <input class="search-input" type="text" name="search" placeholder="Search by name or ID" t-att-value="search"/>
                        <select name="size_id">
                            <option value="">All Sizes</option>
                            <t t-foreach="sizes" t-as="s">
                                <option t-att-value="s.id" t-att-selected="s.id == selected_size">
                                    <t t-esc="s.name"/>
                                </option>
                            </t>
                        </select>
                        <select name="tag_ids" class="o_select2_tags" style="min-width:180px; caret-color:transparent;" multiple="multiple" data-placeholder="Designs...">
                            <t t-foreach="tags" t-as="t">
                                <option t-att-value="t.id" style="display:none;" t-att-selected="t.id in selected_tags">
                                    <t t-esc="t.name"/>
                                </option>
                            </t>
                        </select>
                        <div class="weight-group">
                            Wt
                            <input type="number" step="0.01" name="min_weight" placeholder="Min" t-att-value="min_weight"/>
                            –
                            <input type="number" step="0.01" name="max_weight" placeholder="Max" t-att-value="max_weight"/>
                        </div>
                        <button type="submit">Filter</button>
                    </form>
                </div>

                <t t-if="items">
                    <div id="catalog-grid">
                        <t t-foreach="items" t-as="item">
                            <div class="item-card toggle-item-btn"
                                 t-att-data-barcode="item.barcode"
                                 t-att-data-name="item.name">
                                <span class="item-card-img" t-field="item.image_1920" t-options="{'widget': 'image', 'preview_image': 'image_1920'}"/>
                                <div class="item-card-body">
                                    <div class="item-name"><t t-esc="item.name"/></div>
                                    <div class="item-id"><t t-esc="item.barcode"/></div>
                                    <div class="item-specs">
                                        <div class="spec-block" t-if="item.size">
                                            <span class="spec-label">Size</span>
                                            <span class="spec-value"><t t-esc="item.size.name"/></span>
                                        </div>
                                        <div class="spec-block">
                                            <span class="spec-label">Weight</span>
                                            <span class="spec-value"><span t-field="item.weight" t-options='{"widget": "float", "precision": 3}'/> g</span>
                                        </div>
                                        <div class="spec-block" t-if="item.pieces">
                                            <span class="spec-label">Pieces</span>
                                            <span class="spec-value"><t t-esc="item.pieces"/></span>
                                        </div>
                                    </div>
                                    <div class="item-tags">
                                        <t t-foreach="item.design_tag_ids" t-as="tag">
                                            <span class="item-tag"><t t-esc="tag.name"/></span>
                                        </t>
                                    </div>
                                </div>
                                <div class="item-card-footer">
                                    <button type="button" class="select-btn">Select</button>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>

                <t t-if="not items">
                    <div id="empty-state">Collection is currently being updated. Please check back soon.</div>
                </t>

            </div>

            <div id="floating-cart">
                <a href="#" id="submit-inquiry-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M11.354 6.354a.5.5 0 0 0-.708-.708L8 8.293 6.854 7.146a.5.5 0 1 0-.708.708l1.5 1.5a.5.5 0 0 0 .708 0z"/>
                        <path d="M.5 1a.5.5 0 0 0 0 1h1.11l.401 1.607 1.498 7.985A.5.5 0 0 0 4 12h1a2 2 0 1 0 0 4 2 2 0 0 0 0-4h7a2 2 0 1 0 0 4 2 2 0 0 0 0-4h1a.5.5 0 0 0 .491-.408l1.5-8A.5.5 0 0 0 14.5 3H2.89l-.405-1.621A.5.5 0 0 0 2 1zm3.915 10L3.102 4h10.796l-1.313 7zM6 14a1 1 0 1 1-2 0 1 1 0 0 1 2 0m7 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0"/>
                    </svg>
                    Inquire <span id="cart-count-badge">0</span>
                </a>
            </div>

            <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet"/>
            <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
            <script type="text/javascript">
                $(document).ready(function() {
                    $('.o_select2_tags').select2({ width: '180px', allowClear: true });

                    let selectedItems = JSON.parse(localStorage.getItem('jewelry_cart')) || {};

                    function updateCartUI() {
                        let count = Object.keys(selectedItems).length;
                        $('#cart-count-badge').text(count);
                        count > 0 ? $('#floating-cart').fadeIn() : $('#floating-cart').fadeOut();

                        $('.item-card').each(function() {
                            let barcode = $(this).data('barcode');
                            let btn = $(this).find('.select-btn');
                            if (selectedItems[barcode]) {
                                $(this).addClass('selected');
                                btn.addClass('active').text('Selected');
                            } else {
                                $(this).removeClass('selected');
                                btn.removeClass('active').text('Select');
                            }
                        });
                    }

                    updateCartUI();

                    $(document).on('click', '.item-card', function(e) {
                        if ($(e.target).closest('button[type=submit], a').length) return;
                        let barcode = $(this).data('barcode');
                        let name = $(this).data('name');
                        if (selectedItems[barcode]) {
                            delete selectedItems[barcode];
                        } else {
                            selectedItems[barcode] = name;
                        }
                        localStorage.setItem('jewelry_cart', JSON.stringify(selectedItems));
                        updateCartUI();
                    });

                    $(document).on('click', '.select-btn', function(e) {
                        e.stopPropagation();
                        $(this).closest('.item-card').trigger('click');
                    });

                    $('#submit-inquiry-btn').on('click', function(e) {
                        e.preventDefault();
                        let itemList = "";
                        for (const [barcode, name] of Object.entries(selectedItems)) {
                            itemList += `- ${barcode}: ${name}\n`;
                        }
                        let message = `Hello, I would like to inquire about the following items:\n\n${itemList}\nPlease let me know the availability.`;
                        window.open(`https://wa.me/919884472797?text=${encodeURIComponent(message)}`, '_blank');
                    });
                });
            </script>
        </t>
    </template>
</odoo>
