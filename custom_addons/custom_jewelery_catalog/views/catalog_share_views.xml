<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Image-first picker used when staff click "Add" on a link's Designs.
         Lets designs be chosen by photo instead of by barcode ID. -->
    <record id="view_jewelry_barcode_item_kanban_picker" model="ir.ui.view">
        <field name="name">jewelry.barcode.item.kanban.picker</field>
        <field name="model">jewelry.barcode.item</field>
        <field name="arch" type="xml">
            <kanban string="Designs">
                <field name="barcode"/>
                <field name="name"/>
                <field name="weight"/>
                <field name="pieces"/>
                <field name="size"/>
                <field name="image_1920"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_image text-center">
                            <field name="image_1920" widget="image"
                                   options="{'size': [0, 150]}"
                                   class="w-100"/>
                        </div>
                        <div class="mt-1">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <div class="text-muted">
                                <field name="barcode"/>
                            </div>
                            <div>
                                <field name="weight"/> g
                                <span t-if="record.size.value"> · <field name="size"/></span>
                            </div>
                            <div class="text-muted">
                                <field name="pieces"/> pc(s)
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_jewelry_catalog_share_list" model="ir.ui.view">
        <field name="name">jewelry.catalog.share.list</field>
        <field name="model">jewelry.catalog.share</field>
        <field name="arch" type="xml">
            <list string="Catalog Links" decoration-muted="is_expired">
                <field name="name"/>
                <field name="item_count" string="Designs"/>
                <field name="customer_cart_count" string="Customer Picked"/>
                <field name="cart_updated_on" string="Selection Updated"/>
                <field name="create_date" string="Created"/>
                <field name="expiry" string="Expires"/>
                <field name="is_expired"/>
                <button name="action_open_share_link" type="object"
                        string="Open" icon="fa-external-link"
                        invisible="is_expired"/>
            </list>
        </field>
    </record>

    <record id="view_jewelry_catalog_share_form" model="ir.ui.view">
        <field name="name">jewelry.catalog.share.form</field>
        <field name="model">jewelry.catalog.share</field>
        <field name="arch" type="xml">
            <form string="Catalog Link">
                <header>
                    <button name="action_open_share_link" type="object"
                            string="Open Link" class="btn-primary"
                            invisible="not id or is_expired"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert"
                         invisible="not is_expired">
                        This link has expired and no longer shows anything to the customer.
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Mrs. Sharma - Diamond rings"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="valid_hours"/>
                            <field name="item_count"/>
                        </group>
                        <group>
                            <field name="create_date" invisible="not id"/>
                            <field name="expiry" invisible="not id"/>
                            <field name="is_expired" invisible="not id"/>
                            <field name="share_url" widget="CopyClipboardChar"
                                   invisible="not id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Designs" name="designs">
                            <field name="item_ids" mode="kanban"
                                   context="{'kanban_view_ref': 'custom_jewelery_catalog.view_jewelry_barcode_item_kanban_picker', 'force_dialog_view_type': 'kanban'}">
                                <kanban>
                                    <field name="barcode"/>
                                    <field name="name"/>
                                    <field name="weight"/>
                                    <field name="pieces"/>
                                    <field name="size"/>
                                    <field name="image_1920"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="position-relative">
                                                <a type="delete" role="button"
                                                   title="Remove design" aria-label="Remove design"
                                                   class="fa fa-trash-o text-danger position-absolute top-0 end-0 p-1"
                                                   style="z-index: 2; background: rgba(255,255,255,0.85); border-radius: 4px; line-height: 1;"/>
                                                <div class="o_kanban_image text-center">
                                                    <field name="image_1920" widget="image"
                                                           options="{'size': [0, 140]}"
                                                           class="w-100"/>
                                                </div>
                                                <div class="mt-1">
                                                    <strong class="o_kanban_record_title">
                                                        <field name="name"/>
                                                    </strong>
                                                    <div class="text-muted">
                                                        <field name="barcode"/>
                                                    </div>
                                                    <div>
                                                        <field name="weight"/> g
                                                        <span t-if="record.size.value"> · <field name="size"/></span>
                                                    </div>
                                                    <div class="text-muted">
                                                        <field name="pieces"/> pc(s)
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Customer Selection" name="customer_cart">
                            <group>
                                <field name="customer_cart_count"/>
                                <field name="cart_updated_on"/>
                            </group>
                            <field name="customer_cart_item_ids" readonly="1">
                                <list>
                                    <field name="barcode"/>
                                    <field name="name"/>
                                    <field name="weight"/>
                                    <field name="pieces"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_jewelry_catalog_share_search" model="ir.ui.view">
        <field name="name">jewelry.catalog.share.search</field>
        <field name="model">jewelry.catalog.share</field>
        <field name="arch" type="xml">
            <search string="Catalog Links">
                <field name="name"/>
                <filter name="filter_active" string="Live" domain="[('is_expired', '=', False)]"/>
                <filter name="filter_expired" string="Expired" domain="[('is_expired', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_jewelry_catalog_share" model="ir.actions.act_window">
        <field name="name">Catalog Links</field>
        <field name="res_model">jewelry.catalog.share</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a catalog link</p>
            <p>Pick the designs you want a customer to see, then share the
               generated link. It works for a limited time only.</p>
        </field>
    </record>

    <menuitem id="menu_jewelry_catalog_share"
              name="Catalog Links"
              parent="custom_stock_barcode.menu_jewelry_inventory"
              action="action_jewelry_catalog_share"
              sequence="30"/>

</odoo>
