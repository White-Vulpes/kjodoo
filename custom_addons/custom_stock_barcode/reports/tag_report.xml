<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Physical tag: 100mm wide × 20mm tall, landscape sticker/label.

        wkhtmltopdf quirk 1: orientation=Landscape on a custom format causes it to
        treat page_width/page_height as portrait coordinates and then rotate — content
        goes off-page. Fix: declare Portrait and swap width/height instead.

        wkhtmltopdf quirk 2: default HTML rendering viewport (~1024px) is much wider
        than the physical page (100mm ≈ 378px at 96 DPI), so the entire page is scaled
        down to ~37%, making content appear tiny in a corner.
        Fix: force `html, body { width: 100mm; }` so the renderer works at 1:1 scale.
        Paperformat margins are set to 0; padding is handled via CSS box-sizing.
    -->
    <record id="paper_format_jewelry_tag" model="report.paperformat">
        <field name="name">Jewelry Tag 10×2 cm Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">100</field>
        <field name="page_height">20</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">300</field>
    </record>

    <!-- Report action — prints one page (one tag) per selected item -->
    <record id="action_report_jewelry_tag" model="ir.actions.report">
        <field name="name">Jewelry Tag</field>
        <field name="model">jewelry.barcode.item</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_stock_barcode.report_jewelry_tag_template</field>
        <field name="report_file">custom_stock_barcode.report_jewelry_tag_template</field>
        <field name="paperformat_id" ref="paper_format_jewelry_tag"/>
        <field name="binding_model_id" ref="model_jewelry_barcode_item"/>
        <field name="binding_type">report</field>
    </record>

    <!--
        QWeb template — landscape layout.

        Page:    100mm × 20mm, 0mm paperformat margins.
        Padding: 1mm inside the tag div via box-sizing:border-box.
        Content: 98mm × 18mm usable area.

        Layout (left → right inside the 98mm × 18mm area):
          • QR code  16mm × 16mm  vertically centred
          • 2mm gap
          • Text column 1  ~40mm  — purity/cat, weight/pcs, size/karat, net, barcode
          • Text column 2  ~40mm  — item code, mfr/date, optional less, optional min/max

        Key rules:
          • CSS forces html/body to 100mm wide so wkhtmltopdf renders at 1:1 scale.
          • No class="page" — Odoo base CSS sets min-height:297mm on .page.
          • page-break-after:always only on non-last items (no trailing blank page).
          • QR embedded as base64 data URI — avoids wkhtmltopdf making HTTP requests.
          • display:table used for wkhtmltopdf compatibility over flexbox.
    -->
    <template id="report_jewelry_tag_template">
        <t t-call="web.html_container">
            <style type="text/css">
                html, body {
                    margin: 0 !important;
                    padding: 0 !important;
                    width: 100mm !important;
                    height: 20mm !important;
                }
            </style>
            <t t-foreach="docs" t-as="doc">
                <t t-set="less_line" t-value="doc.less_ids and doc.less_ids[0] or False"/>
                <t t-set="less_type_code" t-value="(less_line.less_type.name[:3].upper() if less_line and less_line.less_type else '')"/>
                <t t-set="less_wt" t-value="(less_line.weight if less_line else 0.0)"/>
                <t t-set="gross_wt" t-value="doc.weight"/>
                <t t-set="enc_pct" t-value="(doc._encode_tag_pct(less_wt, gross_wt) if gross_wt else '')"/>
                <t t-set="enc_less_wt" t-value="(doc._encode_tag_wt(less_wt) if less_wt else '')"/>
                <t t-set="cat_abbrev" t-value="(doc.category.name[:3].upper() if doc.category else '')"/>
                <t t-set="karat" t-value="(doc.purity.karat if doc.purity else '')"/>
                <t t-set="net_int" t-value="int(round(doc.net_weight * 100))"/>
                <t t-set="mcode_name" t-value="(doc.m_code.name if doc.m_code else '')"/>
                <t t-set="enc_min" t-value="(doc._encode_tag_price(doc.min_price) if doc.min_price else '')"/>
                <t t-set="enc_max" t-value="(doc._encode_tag_price(doc.max_price) if doc.max_price else '')"/>

                <!-- Full-page tag div: 100mm × 20mm with 1mm padding all around -->
                <div t-attf-style="page-break-after: {{'always' if not doc_last else 'auto'}}; width: 100mm; height: 20mm; padding: 1mm; box-sizing: border-box; overflow: hidden;">

                    <!-- Table fills the padded area: 98mm × 18mm -->
                    <div style="display: table; width: 100%; height: 100%; border-collapse: collapse;">

                        <!-- QR code — 16mm wide, vertically centred -->
                        <div style="display: table-cell; width: 16mm; vertical-align: middle; text-align: center;">
                            <img t-if="doc.barcode_qr_data"
                                 t-att-src="doc.barcode_qr_data"
                                 style="width: 16mm; height: 16mm; display: inline-block;"/>
                        </div>

                        <!-- Gap -->
                        <div style="display: table-cell; width: 2mm;"/>

                        <!-- Text column 1: purity/cat, weight/pcs, size/karat, net, barcode -->
                        <div style="display: table-cell; vertical-align: middle; font-family: 'Courier New', Courier, monospace; font-size: 8pt; line-height: 1.2; overflow: hidden;">
                            <div style="white-space: nowrap; overflow: hidden;">KJ-<t t-esc="(doc.purity.value if doc.purity else '')"/>&#160;<t t-esc="cat_abbrev"/></div>
                            <div style="white-space: nowrap; overflow: hidden;">WT-<t t-esc="'%.3f' % gross_wt"/>/<t t-esc="doc.pieces"/></div>
                            <div style="white-space: nowrap; overflow: hidden;">S-<t t-esc="(doc.size.name if doc.size else '')"/>&#160;K<t t-esc="karat"/></div>
                            <div style="white-space: nowrap; overflow: hidden;">N<t t-esc="net_int"/></div>
                            <div style="white-space: nowrap; overflow: hidden;"><t t-esc="doc.barcode"/></div>
                        </div>

                        <!-- Text column 2: item code, mfr/date, optional less, optional min/max -->
                        <div style="display: table-cell; vertical-align: middle; font-family: 'Courier New', Courier, monospace; font-size: 8pt; line-height: 1.2; overflow: hidden;">
                            <div style="white-space: nowrap; overflow: hidden;">#<t t-esc="(doc.item_code.name if doc.item_code else '')"/></div>
                            <div style="white-space: nowrap; overflow: hidden;"><t t-esc="mcode_name"/>&#160;<t t-esc="doc._tag_date_str()"/></div>
                            <div t-if="less_line" style="white-space: nowrap; overflow: hidden;"><t t-esc="less_type_code"/><t t-esc="enc_pct"/>W<t t-esc="enc_less_wt"/></div>
                            <div t-if="enc_min or enc_max" style="white-space: nowrap; overflow: hidden;">
                                <t t-if="enc_min">MN<t t-esc="enc_min"/></t><t t-if="enc_min and enc_max">-</t><t t-if="enc_max">MX<t t-esc="enc_max"/></t>
                            </div>
                        </div>

                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
