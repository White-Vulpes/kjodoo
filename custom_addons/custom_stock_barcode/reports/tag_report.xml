<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Physical tag: 100mm wide × 20mm tall, landscape sticker/label.

        wkhtmltopdf quirks documented here:
          1. orientation=Landscape on a custom format rotates content off-page.
             Fix: declare Portrait, swap page_width/page_height.

          2. Default HTML viewport is much wider than the physical page, so
             fixed px/mm sizes render tiny in a corner.
             Fix: vw units for all element sizes (1vw = 1mm on a 100mm page).

          3. wkhtmltopdf ignores vw on CSS font-size (inline and inline stylesheet),
             falling back to Bootstrap's 16px which scales to ~4mm at 378px viewport.
             Fix: set font-size in vw on html via <style> block — this DOES work and
             overrides Bootstrap. Use 4.5vw = 4.5mm = ~12.7pt physical.

          4. Inline SVG <text> elements do not render in wkhtmltopdf — use HTML divs.

        Layout:
          Page:     100vw × 20vw  (= 100mm × 20mm)
          Padding:  1vw each side → content: 98vw × 18vw
          QR:       16vw × 16vw
          Gap:      2vw
          Col 1:    40vw  — KJ/cat, WT/pcs, size/karat, net
          Col 2:    40vw  — barcode, item code, mfr/date, optional rows
          Font:     4.5vw = 4.5mm = ~12.7pt
          Row ht:   4.5vw × 1.0 line-height → 4 rows = 18vw = content height ✓
    -->
    <record id="paper_format_jewelry_tag" model="report.paperformat">
        <field name="name">Jewelry Tag 10×2 cm Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">100</field>
        <field name="page_height">20</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">300</field>
    </record>

    <!-- Report action — prints one page (one tag) per selected item -->
    <record id="action_report_jewelry_tag" model="ir.actions.report">
        <field name="name">Jewelry Tag</field>
        <field name="model">jewelry.barcode.item</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_stock_barcode.report_jewelry_tag_template</field>
        <field name="report_file">custom_stock_barcode.report_jewelry_tag_template</field>
        <field name="paperformat_id" ref="paper_format_jewelry_tag"/>
        <field name="binding_model_id" ref="model_jewelry_barcode_item"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_jewelry_tag_template">
        <t t-call="web.html_container">
            <t t-set="full_width" t-value="True"/>
            <style type="text/css">
                html, body, #wrapwrap, main {
                    margin: 0 !important;
                    padding: 0 !important;
                    width: 100% !important;
                    min-width: 0 !important;
                    max-width: none !important;
                    overflow: hidden !important;
                }
                .container, .container-fluid, .container-xxl, .container-xl {
                    max-width: none !important;
                    width: 100% !important;
                    padding: 0 !important;
                    margin: 0 !important;
                }
                /*
                 * 46px = 4.5mm at wkhtmltopdf default 1024px viewport scaled to 100mm.
                 * vw ignored by old WebKit for font-size; px is reliable on Linux.
                 * 4 rows x 46px x line-height 1.0 fits the 18vw content height.
                 */
                html {
                    font-size: 30px !important;
                    line-height: 1.1 !important;
                }
            </style>
            <t t-foreach="docs" t-as="doc">
                <t t-set="less_line" t-value="doc.less_ids and doc.less_ids[0] or False"/>
                <t t-set="less_type_code" t-value="(less_line.less_type.name[:3].upper() if less_line and less_line.less_type else '')"/>
                <t t-set="less_wt" t-value="(less_line.weight if less_line else 0.0)"/>
                <t t-set="gross_wt" t-value="doc.weight"/>
                <t t-set="enc_pct" t-value="(doc._encode_tag_pct(less_wt, gross_wt) if gross_wt else '')"/>
                <t t-set="enc_less_wt" t-value="(doc._encode_tag_wt(less_wt) if less_wt else '')"/>
                <t t-set="cat_abbrev" t-value="(doc.category.name[:3].upper() if doc.category else '')"/>
                <t t-set="karat" t-value="(doc.purity.karat if doc.purity else '')"/>
                <t t-set="net_int" t-value="int(round(doc.net_weight * 100))"/>
                <t t-set="mcode_name" t-value="(doc.m_code.name if doc.m_code else '')"/>
                <t t-set="enc_min" t-value="(doc._encode_tag_price(doc.min_price) if doc.min_price else '')"/>
                <t t-set="enc_max" t-value="(doc._encode_tag_price(doc.max_price) if doc.max_price else '')"/>

                <!-- padding-left: 30vw reserves handle area; vw on block padding works in wkhtmltopdf -->
                <div t-attf-style="page-break-after: {{'always' if not doc_last else 'auto'}}; width: 100vw; height: 20vw; padding-left: 30vw; padding-top: 1vw; padding-bottom: 1vw; padding-right: 1vw; box-sizing: border-box; overflow: hidden;">
                    <div style="display: table; width: 100%; height: 100%; border-collapse: collapse;">

                        <!-- QR: 50% of remaining 70vw = 35vw -->
                        <div style="display: table-cell; width: 50%; vertical-align: middle; text-align: center;">
                            <img t-if="doc.barcode_qr_data"
                                 t-att-src="doc.barcode_qr_data"
                                 style="width: 18vw; height: 18vw; display: inline-block;"/>
                        </div>

                        <!-- Text: 50% of remaining 70vw = 35vw -->
                        <div style="display: table-cell; width: 50%; vertical-align: middle; font-family: 'Courier New', Courier, monospace; overflow: hidden;">
                            <div style="white-space: nowrap; overflow: hidden;">KJ-<t t-esc="(doc.purity.value if doc.purity else '')"/> <t t-esc="cat_abbrev"/></div>
                            <div style="white-space: nowrap; overflow: hidden;">WT-<t t-esc="'%.3f' % gross_wt"/>/<t t-esc="doc.pieces"/></div>
                            <div style="white-space: nowrap; overflow: hidden;">S-<t t-esc="(doc.size.name if doc.size else '')"/> K<t t-esc="karat"/> N<t t-esc="net_int"/></div>
                            <div style="white-space: nowrap; overflow: hidden;"><t t-esc="doc.barcode"/></div>
                            <div style="white-space: nowrap; overflow: hidden;">#<t t-esc="(doc.item_code.name if doc.item_code else '')"/> <t t-esc="mcode_name"/></div>
                            <div style="white-space: nowrap; overflow: hidden;"><t t-esc="doc._tag_date_str()"/></div>
                            <div t-if="less_line" style="white-space: nowrap; overflow: hidden;"><t t-esc="less_type_code"/><t t-esc="enc_pct"/>W<t t-esc="enc_less_wt"/></div>
                            <div t-if="enc_min or enc_max" style="white-space: nowrap; overflow: hidden;"><t t-if="enc_min">MN<t t-esc="enc_min"/></t><t t-if="enc_min and enc_max">-</t><t t-if="enc_max">MX<t t-esc="enc_max"/></t></div>
                        </div>

                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
