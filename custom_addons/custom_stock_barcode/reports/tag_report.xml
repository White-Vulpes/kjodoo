<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Physical tag: 100mm wide × 20mm tall, landscape sticker/label.

        wkhtmltopdf quirks:
          1. orientation=Landscape on a custom format rotates content off-page.
             Fix: declare Portrait, swap page_width/page_height so the coordinate
             system is 100mm wide × 20mm tall.
          2. Default HTML viewport is wider than the physical page, so fixed px/mm
             sizes render tiny. vw units (1vw = 1mm on a 100mm page) solve this.
          3. vw on CSS font-size is ignored by wkhtmltopdf's old WebKit.
             Fix: set font-size in px on html via <style> block — this works and
             overrides Bootstrap. 46px ≈ 4.5mm at the 1024px default viewport.
          4. Inline SVG <text> does not render — use HTML divs.

        Columns  (total = 100vw):
          Handle : 30vw  — string/loop hole, no content
          QR     : 16vw  — barcode_qr_data embedded as base64 PNG
          Left   : 27vw  — 4 lines: purity/cat, weight/pcs, size/karat, net
          Right  : 27vw  — 4 lines: barcode, item code, mcode/date, less or price

        Font: 46px (html) × line-height 1.0 → 4 rows = 184px ≈ 18mm → fits 20mm ✓
        Char width (Courier New monospace): 46px × 0.6 = 27.6px ≈ 2.7mm
        Chars per column at 27vw (≈27mm): 27/2.7 ≈ 10 chars — fits all label content
    -->
    <record id="paper_format_jewelry_tag" model="report.paperformat">
        <field name="name">Jewelry Tag 10×2 cm Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">100</field>
        <field name="page_height">20</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">300</field>
    </record>

    <!-- Report action — one page per selected item -->
    <record id="action_report_jewelry_tag" model="ir.actions.report">
        <field name="name">Jewelry Tag</field>
        <field name="model">jewelry.barcode.item</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_stock_barcode.report_jewelry_tag_template</field>
        <field name="report_file">custom_stock_barcode.report_jewelry_tag_template</field>
        <field name="paperformat_id" ref="paper_format_jewelry_tag"/>
        <field name="binding_model_id" ref="model_jewelry_barcode_item"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_jewelry_tag_template">
        <t t-call="web.html_container">
            <t t-set="full_width" t-value="True"/>
            <style type="text/css">
                html, body, #wrapwrap, main {
                    margin: 0 !important;
                    padding: 0 !important;
                    width: 100% !important;
                    min-width: 0 !important;
                    max-width: none !important;
                    overflow: hidden !important;
                }
                .container, .container-fluid, .container-xxl, .container-xl {
                    max-width: none !important;
                    width: 100% !important;
                    padding: 0 !important;
                    margin: 0 !important;
                }
                html {
                    font-size: 46px !important;
                    line-height: 1.0 !important;
                }
            </style>
            <t t-foreach="docs" t-as="doc">
                <!-- Base values -->
                <t t-set="gross_wt" t-value="doc.weight"/>
                <t t-set="less_wt" t-value="(doc.less_ids[0].weight if doc.less_ids else 0.0)"/>
                <t t-set="karat" t-value="(doc.purity.karat if doc.purity else '')"/>
                <t t-set="mcode_name" t-value="(doc.m_code.name if doc.m_code else '')"/>
                <t t-set="enc_min" t-value="(doc._encode_tag_price(doc.min_price) if doc.min_price else '')"/>
                <t t-set="enc_max" t-value="(doc._encode_tag_price(doc.max_price) if doc.max_price else '')"/>

                <!-- Adjusted net weight for N display -->
                <t t-set="less_pct" t-value="doc.less_deduction_pct"/>
                <t t-set="adj_less_wt" t-value="less_wt * (1.0 - less_pct / 100.0) if (less_pct and less_wt) else less_wt"/>
                <t t-set="adj_net_int" t-value="int(round((gross_wt - adj_less_wt) * 100))"/>

                <!-- Charges (after the tag's charge deduction %) for the N…C… line -->
                <t t-set="charge_pct" t-value="doc.charge_deduction_pct"/>
                <t t-set="adj_charges" t-value="doc.total_charges * (1.0 - charge_pct / 100.0) if charge_pct else doc.total_charges"/>
                <t t-set="adj_charges_int" t-value="int(round(adj_charges))"/>

                <!--
                    Each tag is a BLOCK wrapper (not a table) with a definite height and
                    overflow:hidden. This matters:
                      * display:table IGNORES overflow:hidden in wkhtmltopdf, so the table
                        can never be relied on to clamp its own height. A block wrapper does
                        honour overflow:hidden, so anything taller than 18vw is clipped
                        instead of spilling onto a second (blank) physical page.
                      * height MUST be a definite length (18vw ≈ 18mm on this 100mm page),
                        not height:100% — the body has no fixed height, so % resolves
                        ambiguously and stacked tags grow unbounded.
                    The QR <img> is given a FIXED square size (14vw) so every tag renders an
                    identical QR — otherwise its intrinsic pixel size varies per tag, which
                    both changed the row height (blank pages) and shifted the vertical
                    centring (columns no longer lined up).
                -->
                <div t-attf-style="page-break-after: {{'always' if not doc_last else 'auto'}}; width: 100%; height: 18vw; overflow: hidden;">
                    <div style="width: 100%; height: 18vw; display: table; table-layout: fixed; border-collapse: collapse;">

                        <!-- Col 1 (30%): handle/loop hole, intentionally blank -->
                        <div style="display: table-cell; width: 30%;"/>

                        <!--
                            QR gets its OWN fixed-width column. wkhtmltopdf's old WebKit
                            ignores vw/px sizing on an <img> and falls back to the image's
                            intrinsic pixel size (which is why 5vw/7vw all looked the same),
                            but it DOES honour a % width on a fixed-layout table cell — that
                            is exactly how the text columns size correctly. So this cell's %
                            width defines the QR box and the image just fills it. Change this
                            width (rebalancing the others toward 100%) to resize the QR.
                        -->
                        <div style="display: table-cell; width: 10%; vertical-align: middle;">
                            <img t-if="doc.barcode_qr_data" t-att-src="doc.barcode_qr_data" style="width: 100%; height: auto; display: block;"/>
                        </div>

                        <!-- Specs face (31%) -->
                        <div style="display: table-cell; width: 31%; padding-left: 3px; vertical-align: middle; font-family: 'Courier New', Courier, monospace;">
                            <div style="white-space: nowrap; overflow: hidden;">KJ-<t t-esc="doc.item_code or ''"/></div>
                            <div style="white-space: nowrap; overflow: hidden;">WT-<t t-esc="'%.3f' % gross_wt"/>/<t t-esc="doc.pieces"/></div>
                            <div style="white-space: nowrap; overflow: hidden;">S-<t t-esc="(doc.size.name if doc.size else '')"/> K<t t-esc="karat"/></div>
                            <div style="white-space: nowrap; overflow: hidden;">N<t t-esc="adj_net_int"/>C<t t-esc="adj_charges_int"/></div>
                        </div>

                        <!-- Gap (1%) -->
                        <div style="display: table-cell; width: 1%;"/>

                        <!-- Barcode / price face (30%) -->
                        <div style="display: table-cell; width: 30%; vertical-align: middle; font-family: 'Courier New', Courier, monospace;">
                            <div style="white-space: nowrap; overflow: hidden;"><t t-esc="doc.barcode"/></div>
                            <div style="white-space: nowrap; overflow: hidden;"><t t-esc="mcode_name"/> <t t-esc="doc._tag_date_str()"/></div>
                            <div t-if="enc_min or enc_max" style="white-space: nowrap; overflow: hidden;"><t t-esc="enc_min"/><t t-if="enc_min and enc_max">-</t><t t-esc="enc_max"/></div>
                            <div t-if="doc.narration" style="white-space: nowrap; overflow: hidden;"><t t-esc="doc.narration"/></div>
                        </div>

                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
