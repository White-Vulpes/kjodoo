<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_jewelry_barcode_item_form" model="ir.ui.view">
        <field name="name">jewelry.barcode.item.form</field>
        <field name="model">jewelry.barcode.item</field>
        <field name="arch" type="xml">
            <form string="Jewelry Item">
                <header>
                    <button name="action_print_tag" type="object" string="Print Tag" class="btn-primary"/>
                </header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name" string="Item Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Gold Floral Ring" default_focus="1"/>
                        </h1>
                        <label for="barcode" string="Barcode ID"/>
                        <field name="barcode"/>
                    </div>

                    <group>
                        <group string="Classification">
                            <field name="category"/>
                            <field name="subcategory"/>
                            <field name="item_code" placeholder="Auto (category-subcategory)"/>
                        </group>
                        <group string="Attributes">
                            <field name="purity"/>
                            <field name="make"/>
                            <field name="size"/>
                            <field name="m_code"/>
                            <field name="pieces"/>
                            <field name="design_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                    </group>

                    <group>
                        <group string="Weight">
                            <field name="weight"/>
                            <field name="net_weight" class="fw-bold text-success"/>
                            <field name="total_charges"/>
                        </group>
                        <group string="Pricing">
                            <field name="less_deduction_pct"/>
                            <field name="charge_deduction_pct"/>
                            <field name="min_price"/>
                            <field name="max_price"/>
                        </group>
                    </group>

                    <group string="Less (Deductions)">
                        <field name="less_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="less_type"/>
                                <field name="weight" sum="Total Less"/>
                            </list>
                        </field>
                    </group>

                    <group string="Charges">
                        <field name="charge_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="amount" sum="Total Charges"/>
                            </list>
                        </field>
                    </group>

                    <group string="Narration">
                        <field name="narration" nolabel="1" colspan="2" placeholder="Add any additional notes about this item here..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_jewelry_barcode_item_list" model="ir.ui.view">
        <field name="name">jewelry.barcode.item.list</field>
        <field name="model">jewelry.barcode.item</field>
        <field name="arch" type="xml">
            <list string="Jewelry Items">
                <field name="barcode"/>
                <field name="item_code" optional="show"/>
                <field name="name"/>
                <field name="category" optional="show"/>
                <field name="purity" optional="show"/>
                <field name="m_code" optional="show"/>
                <field name="design_tag_ids" widget="many2many_tags" optional="show"/>
                <field name="weight" sum="Total Gross Weight"/>
                <field name="net_weight" sum="Total Net Weight"/>
            </list>
        </field>
    </record>

    <record id="view_jewelry_barcode_item_search" model="ir.ui.view">
        <field name="name">jewelry.barcode.item.search</field>
        <field name="model">jewelry.barcode.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="barcode"/>
                <field name="item_code"/>
                <field name="name"/>
                <field name="m_code"/>
                <field name="category"/>
                <field name="design_tag_ids" string="Design Tags" filter_domain="[('design_tag_ids.name', 'ilike', self)]"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
                <group>
                    <filter string="Category" name="group_category" domain="[]" context="{'group_by':'category'}"/>
                    <filter string="Manufacturer Code" name="group_m_code" domain="[]" context="{'group_by':'m_code'}"/>
                    <filter string="Size" name="group_size" domain="[]" context="{'group_by':'size'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_jewelry_barcode_item" model="ir.actions.act_window">
        <field name="name">Barcode Inventory</field>
        <field name="res_model">jewelry.barcode.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_jewelry_design_tag" model="ir.actions.act_window">
        <field name="name">Design Tags</field>
        <field name="res_model">jewelry.design.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_jewelry_mcode" model="ir.actions.act_window">
        <field name="name">Manufacturer Codes</field>
        <field name="res_model">jewelry.mcode</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_jewelry_size" model="ir.actions.act_window">
        <field name="name">Sizes</field>
        <field name="res_model">jewelry.size</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_jewelry_less_type" model="ir.actions.act_window">
        <field name="name">Less Types</field>
        <field name="res_model">jewelry.less.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_jewelry_purity" model="ir.actions.act_window">
        <field name="name">Purities</field>
        <field name="res_model">jewelry.purity</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_jewelry_category_list" model="ir.ui.view">
        <field name="name">jewelry.category.list</field>
        <field name="model">jewelry.category</field>
        <field name="arch" type="xml">
            <list string="Categories" editable="bottom">
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_jewelry_category_form" model="ir.ui.view">
        <field name="name">jewelry.category.form</field>
        <field name="model">jewelry.category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <sheet>
                    <group>
                        <field name="code" placeholder="e.g. RG"/>
                        <field name="name" placeholder="e.g. Rings"/>
                    </group>
                    <group string="Sub-Categories">
                        <field name="subcategory_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="code"/>
                                <field name="name"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_jewelry_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">jewelry.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_jewelry_subcategory_list" model="ir.ui.view">
        <field name="name">jewelry.subcategory.list</field>
        <field name="model">jewelry.subcategory</field>
        <field name="arch" type="xml">
            <list string="Sub-Categories" editable="bottom">
                <field name="category_id"/>
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_jewelry_subcategory" model="ir.actions.act_window">
        <field name="name">Sub-Categories</field>
        <field name="res_model">jewelry.subcategory</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_jewelry_make" model="ir.actions.act_window">
        <field name="name">Makes</field>
        <field name="res_model">jewelry.make</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_jewelry_inventory" name="Inventory" sequence="20" web_icon="custom_stock_barcode,static/description/icon.png"/>
    <menuitem id="menu_jewelry_barcode_items" name="Barcode Items" parent="menu_jewelry_inventory" action="action_jewelry_barcode_item" sequence="10"/>

    <menuitem id="menu_jewelry_config" name="Configuration" parent="menu_jewelry_inventory" sequence="100"/>

    <menuitem id="menu_config_mcode" name="Manufacturer Codes" parent="menu_jewelry_config" action="action_jewelry_mcode" sequence="10"/>
    <menuitem id="menu_config_size" name="Sizes" parent="menu_jewelry_config" action="action_jewelry_size" sequence="20"/>
    <menuitem id="menu_config_less_type" name="Less Types" parent="menu_jewelry_config" action="action_jewelry_less_type" sequence="30"/>
    <menuitem id="menu_config_design_tag" name="Design Tags" parent="menu_jewelry_config" action="action_jewelry_design_tag" sequence="40"/>
    <menuitem id="menu_config_purity" name="Purities" parent="menu_jewelry_config" action="action_jewelry_purity" sequence="60"/>
    <menuitem id="menu_config_category" name="Categories" parent="menu_jewelry_config" action="action_jewelry_category" sequence="70"/>
    <menuitem id="menu_config_subcategory" name="Sub-Categories" parent="menu_jewelry_config" action="action_jewelry_subcategory" sequence="80"/>
    <menuitem id="menu_config_make" name="Makes" parent="menu_jewelry_config" action="action_jewelry_make" sequence="90"/>
</odoo>